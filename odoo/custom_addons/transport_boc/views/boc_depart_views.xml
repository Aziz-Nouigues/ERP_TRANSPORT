<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         COURRIER DÉPART — FORMULAIRE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_depart_form" model="ir.ui.view">
        <field name="name">boc.courrier.depart.form</field>
        <field name="model">boc.courrier.depart</field>
        <field name="arch" type="xml">
            <form string="Courrier Départ">
                <header>
                    <button name="action_enregistrer" string="✅ Enregistrer"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_envoyer" string="📨 Marquer Envoyé"
                            type="object" class="btn-success"
                            invisible="state != 'enregistre'"/>
                    <button name="action_classer" string="🗂️ Classer"
                            type="object"
                            invisible="state != 'envoye'"/>
                    <button name="action_reset" string="Remettre en brouillon"
                            type="object"
                            invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,enregistre,envoye,classe"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="type_depart" widget="radio" options="{'horizontal': true}"/>
                            <field name="type_courrier_id"/>
                            <field name="support"/>
                            <field name="reference_interne"/>
                        </group>
                        <group string="Dates">
                            <field name="date_depart"/>
                            <field name="responsable_id"/>
                            <field name="service_expediteur"/>
                        </group>
                    </group>

                    <group>
                        <group string="Destinataire">
                            <field name="organisme_id"/>
                            <field name="destinataire_nom"
                                   invisible="organisme_id != False"/>
                        </group>
                        <group string="Lien avec arrivée">
                            <field name="arrivee_id"/>
                        </group>
                    </group>

                    <group string="Contenu">
                        <field name="sujet_id"/>
                        <field name="sujet" placeholder="Objet du courrier..."/>
                    </group>
                    <field name="description" placeholder="Description / Remarques..."/>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         COURRIER DÉPART — LISTE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_depart_list" model="ir.ui.view">
        <field name="name">boc.courrier.depart.list</field>
        <field name="model">boc.courrier.depart</field>
        <field name="arch" type="xml">
            <list string="Courriers Départ">
                <field name="name"/>
                <field name="date_depart"/>
                <field name="type_depart"/>
                <field name="type_courrier_id"/>
                <field name="organisme_id"/>
                <field name="sujet"/>
                <field name="support"/>
                <field name="arrivee_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'envoye'"
                       decoration-info="state == 'enregistre'"
                       decoration-muted="state == 'classe'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         COURRIER DÉPART — RECHERCHE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_depart_search" model="ir.ui.view">
        <field name="name">boc.courrier.depart.search</field>
        <field name="model">boc.courrier.depart</field>
        <field name="arch" type="xml">
            <search>
                <filter name="externe" string="Externe"
                        domain="[('type_depart','=','externe')]"/>
                <filter name="interne" string="Interne"
                        domain="[('type_depart','=','interne')]"/>
                <filter name="non_envoye" string="Non envoye"
                        domain="[('state','in',['brouillon','enregistre'])]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by':'type_courrier_id'}"/>
                    <filter name="group_state" string="Etat" context="{'group_by':'state'}"/>
                    <filter name="group_mois" string="Mois" context="{'group_by':'date_depart:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ACTION COURRIER DÉPART
    ══════════════════════════════════════════════════ -->
    <record id="action_boc_depart" model="ir.actions.act_window">
        <field name="name">Courrier Départ</field>
        <field name="res_model">boc.courrier.depart</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_depart_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun courrier départ pour le moment.
            </p>
            <p>Cliquez sur <strong>Nouveau</strong> pour enregistrer un courrier.</p>
        </field>
    </record>

</odoo>