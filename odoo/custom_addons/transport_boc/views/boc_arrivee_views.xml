<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         COURRIER ARRIVÉE — FORMULAIRE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_arrivee_form" model="ir.ui.view">
        <field name="name">boc.courrier.arrivee.form</field>
        <field name="model">boc.courrier.arrivee</field>
        <field name="arch" type="xml">
            <form string="Courrier Arrivée">

                <!-- Barre de statut -->
                <header>
                    <button name="action_enregistrer" string="Enregistrer"
                            type="object" class="btn-primary"
                            groups="transport_boc.group_agent_boc"
                            invisible="state != 'brouillon'"/>
                    <button name="action_diffuser" string="Diffuser"
                            type="object" class="btn-primary"
                            groups="transport_boc.group_responsable_boc"
                            invisible="state != 'enregistre'"/>
                    <button name="action_traiter" string="✔️ Marquer Traité"
                            type="object" class="btn-success"
                            groups="transport_boc.group_agent_boc"
                            invisible="state not in ('enregistre','diffuse')"/>
                    <button name="action_classer" string="Classer"
                            type="object"
                            groups="transport_boc.group_responsable_boc"
                            invisible="state != 'traite'"/>
                    <button name="action_reset" string="Remettre en brouillon"
                            type="object"
                            groups="transport_boc.group_responsable_boc"
                            invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,enregistre,diffuse,traite,classe"/>
                </header>

                <sheet>
                    <!-- Alerte retard -->
                    <div class="alert alert-danger" role="alert"
                         invisible="not en_retard">
                        Ce courrier est <strong>en retard</strong> !
                        Échéance dépassée de <field name="jours_restants" nolabel="1"/> jour(s).
                    </div>

                    <!-- Alerte rappel : on approche de l'échéance -->
                    <div class="alert alert-warning" role="alert"
                         invisible="en_retard or not necessite_reponse or not date_rappel or reponse_fournie">
                        <strong>Rappel :</strong> Ce courrier nécessite une réponse.
                        Date d'échéance : <field name="date_echeance" nolabel="1" readonly="1"/>.
                    </div>

                    <!-- Entête -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="type_arrivee" widget="radio" options="{'horizontal': true}"/>
                            <field name="type_courrier_id"/>
                            <field name="annee_exercice"/>
                            <field name="periodique_id" readonly="1"
                                   invisible="not est_periodique"/>
                        </group>
                        <group string="Dates">
                            <field name="date_arrivee"/>
                            <field name="date_courrier"/>
                            <field name="date_echeance"/>
                            <field name="date_rappel" readonly="1"
                                   invisible="not date_echeance"/>
                        </group>
                    </group>

                    <!-- ── EXPÉDITEUR EXTERNE ── -->
                    <group string="Expéditeur" invisible="type_arrivee != 'externe'">
                        <group>
                            <field name="organisme_id"
                                   string="Organisme expéditeur"
                                   domain="[('type_organisme','=','externe')]"
                                   options="{'no_quick_create': False}"/>
                            <field name="expediteur_nom"
                                   string="Nom expéditeur (libre)"
                                   invisible="organisme_id != False"
                                   placeholder="Si non référencé dans la liste..."/>
                            <field name="reference_expediteur"/>
                        </group>
                        <group>
                            <field name="necessite_reponse"/>
                            <field name="reponse_fournie"
                                   invisible="not necessite_reponse"/>
                            <field name="date_reponse"
                                   invisible="not reponse_fournie"/>
                            <field name="depart_reponse_id"
                                   invisible="not reponse_fournie"/>
                        </group>
                    </group>

                    <!-- ── EXPÉDITEUR INTERNE ── -->
                    <group string="Expéditeur interne" invisible="type_arrivee != 'interne'">
                        <group>
                            <field name="organisme_id"
                                   string="Direction / Service expéditeur"
                                   domain="[('type_organisme','=','interne')]"
                                   options="{'no_quick_create': False}"/>
                            <field name="expediteur_nom"
                                   string="Nom (si non référencé)"
                                   invisible="organisme_id != False"
                                   placeholder="Nom de l'expéditeur interne..."/>
                            <!-- Référence expéditeur masquée pour interne (moins pertinente) -->
                            <field name="reference_expediteur"
                                   string="Référence interne"
                                   placeholder="Réf. interne si applicable"/>
                        </group>
                        <group>
                            <field name="necessite_reponse"/>
                            <field name="reponse_fournie"
                                   invisible="not necessite_reponse"/>
                            <field name="date_reponse"
                                   invisible="not reponse_fournie"/>
                            <field name="depart_reponse_id"
                                   invisible="not reponse_fournie"/>
                        </group>
                    </group>

                    <!-- ── CONTENU ── -->
                    <group string="Contenu">
                        <field name="sujet_id"/>
                        <field name="sujet" placeholder="Objet du courrier..."/>
                        <field name="annotation_id"/>
                    </group>
                    <field name="description" placeholder="Description / Remarques..."/>

                    <!-- ── SECTION FACTURE : uniquement pour courrier EXTERNE ── -->
                    <group string="Informations Facture"
                           invisible="type_arrivee != 'externe' or not est_facture">
                        <group>
                            <field name="reference_facture"/>
                            <field name="fournisseur"/>
                        </group>
                        <group>
                            <field name="montant_facture"/>
                        </group>
                    </group>

                    <!-- Message informatif pour courrier interne : pas de facture -->
                    <div class="alert alert-info" role="alert"
                         invisible="type_arrivee != 'interne' or not est_facture">
                        <strong>Information :</strong> Les factures sont associées aux courriers externes uniquement.
                        Veuillez changer le type de courrier si nécessaire.
                    </div>

                    <!-- ── ONGLETS ── -->
                    <notebook>
                        <page string="Diffusions" name="diffusions">
                            <field name="transmission_ids">
                                <list editable="bottom">
                                    <field name="organisme_id"
                                           domain="[('type_organisme','=','interne')]"/>
                                    <field name="destinataire_nom"/>
                                    <field name="instruction_id"/>
                                    <field name="instruction"/>
                                    <field name="date_transmission"/>
                                    <field name="date_echeance"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet GED -->
                        <page string="GED / Archivage" name="ged">
                            <group>
                                <group string="Référence document">
                                    <field name="ged_document_ref"
                                           placeholder="ex: DOC-2025-00123"/>
                                    <field name="ged_archive_status"/>
                                    <field name="ged_archive_date"
                                           invisible="ged_archive_status == 'non_archive'"/>
                                </group>
                                <group string="Accès GED">
                                    <field name="ged_url"
                                           placeholder="https://ged.exemple.com/document/..."/>
                                    <button name="action_ouvrir_ged"
                                            string="Ouvrir dans la GED"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="not ged_url"/>
                                </group>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert"
                                     invisible="ged_archive_status != 'non_archive'">
                                    <p>Ce courrier n'est pas encore archivé dans la GED.</p>
                                    <button name="action_marquer_archive_ged"
                                            string="Marquer comme archivé"
                                            type="object"
                                            class="btn-primary"
                                            invisible="not ged_document_ref"/>
                                </div>
                                <div class="alert alert-success" role="alert"
                                     invisible="ged_archive_status != 'archive'">
                                    <p>Document archivé dans la GED.</p>
                                    <button name="action_restaurer_ged"
                                            string="Marquer comme restauré"
                                            type="object"
                                            class="btn-secondary"/>
                                </div>
                            </group>
                        </page>

                    </notebook>

                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         COURRIER ARRIVÉE — LISTE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_arrivee_list" model="ir.ui.view">
        <field name="name">boc.courrier.arrivee.list</field>
        <field name="model">boc.courrier.arrivee</field>
        <field name="arch" type="xml">
            <list string="Courriers Arrivée"
                  decoration-danger="en_retard == True"
                  decoration-warning="necessite_reponse == True and reponse_fournie == False and en_retard == False">
                <field name="name"/>
                <field name="date_arrivee"/>
                <field name="type_arrivee"/>
                <field name="type_courrier_id"/>
                <field name="organisme_id"/>
                <field name="sujet"/>
                <field name="date_echeance"/>
                <field name="necessite_reponse" optional="show"/>
                <field name="reponse_fournie" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'traite'"
                       decoration-info="state == 'diffuse'"
                       decoration-warning="state == 'enregistre'"
                       decoration-muted="state == 'classe'"/>
                <field name="en_retard" invisible="1"/>
                <field name="est_periodique" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         COURRIER ARRIVÉE — RECHERCHE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_arrivee_search" model="ir.ui.view">
        <field name="name">boc.courrier.arrivee.search</field>
        <field name="model">boc.courrier.arrivee</field>
        <field name="arch" type="xml">
            <search>
                <!-- Champs de recherche texte -->
                <field name="name" string="N° d'ordre"/>
                <field name="sujet" string="Sujet / Objet"/>
                <field name="expediteur_nom" string="Nom expéditeur"/>
                <field name="organisme_id" string="Organisme"/>
                <field name="reference_expediteur" string="Référence expéditeur"/>
                <field name="fournisseur" string="Fournisseur"/>
                <field name="reference_facture" string="Référence facture"/>
                <separator/>
                <filter name="en_retard" string="En retard"
                        domain="[('en_retard','=',True)]"/>
                <filter name="necessite_reponse" string="Nécessite réponse"
                        domain="[('necessite_reponse','=',True),('reponse_fournie','=',False)]"/>
                <separator/>
                <filter name="externe" string="Externe"
                        domain="[('type_arrivee','=','externe')]"/>
                <filter name="interne" string="Interne"
                        domain="[('type_arrivee','=','interne')]"/>
                <separator/>
                <filter name="brouillon" string="Brouillon"
                        domain="[('state','=','brouillon')]"/>
                <filter name="enregistre" string="Enregistré"
                        domain="[('state','=','enregistre')]"/>
                <filter name="diffuse" string="Diffusé"
                        domain="[('state','=','diffuse')]"/>
                <filter name="traite" string="Traité"
                        domain="[('state','=','traite')]"/>
                <separator/>
                <filter name="ged_non_archive" string="Non archivé GED"
                        domain="[('ged_archive_status','=','non_archive')]"/>
                <filter name="ged_archive" string="Archivé GED"
                        domain="[('ged_archive_status','=','archive')]"/>
                <group>
                    <filter name="group_type" string="Nature courrier" context="{'group_by':'type_courrier_id'}"/>
                    <filter name="group_type_arrivee" string="Type (interne/externe)" context="{'group_by':'type_arrivee'}"/>
                    <filter name="group_state" string="État" context="{'group_by':'state'}"/>
                    <filter name="group_organisme" string="Expéditeur" context="{'group_by':'organisme_id'}"/>
                    <filter name="group_mois" string="Mois" context="{'group_by':'date_arrivee:month'}"/>
                    <filter name="group_ged" string="Statut GED" context="{'group_by':'ged_archive_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ACTION COURRIER ARRIVÉE
    ══════════════════════════════════════════════════ -->
    <record id="action_boc_arrivee" model="ir.actions.act_window">
        <field name="name">Courrier Arrivée</field>
        <field name="res_model">boc.courrier.arrivee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_arrivee_search"/>
        <field name="context">{'search_default_enregistre': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun courrier arrivée pour le moment.
            </p>
            <p>Cliquez sur <strong>Nouveau</strong> pour enregistrer un courrier.</p>
        </field>
    </record>

    <!-- Action filtrée : courriers nécessitant une réponse -->
    <record id="action_boc_arrivee_sans_suite" model="ir.actions.act_window">
        <field name="name">Courriers sans suite</field>
        <field name="res_model">boc.courrier.arrivee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('necessite_reponse','=',True),('reponse_fournie','=',False)]</field>
        <field name="context">{'search_default_en_retard': 1}</field>
    </record>

</odoo>