<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         TRANSMISSION — LISTE PRINCIPALE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_transmission_list" model="ir.ui.view">
        <field name="name">boc.transmission.list</field>
        <field name="model">boc.transmission</field>
        <field name="arch" type="xml">
            <list string="Transmissions"
                  decoration-warning="state == 'en_attente'"
                  decoration-success="state == 'traite'">
                <field name="arrivee_id"/>
                <field name="type_transmission"/>
                <field name="organisme_id"/>
                <field name="destinataire_nom"/>
                <field name="instruction"/>
                <field name="date_transmission"/>
                <field name="date_echeance"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'en_attente'"
                       decoration-info="state == 'transfere'"
                       decoration-success="state == 'traite'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         TRANSMISSION — FORMULAIRE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_transmission_form" model="ir.ui.view">
        <field name="name">boc.transmission.form</field>
        <field name="model">boc.transmission</field>
        <field name="arch" type="xml">
            <form string="Transmission">
                <header>
                    <button name="action_transferer" string="Transférer"
                            type="object" class="btn-primary"
                            invisible="state != 'en_attente'"/>
                    <button name="action_accuser" string="Accuser réception"
                            type="object"
                            invisible="state != 'transfere'"/>
                    <button name="action_traiter" string="Marquer Traité"
                            type="object" class="btn-success"
                            invisible="state == 'traite'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="en_attente,transfere,accuse,traite"/>
                </header>
                <sheet>
                    <group>
                        <group string="Mail">
                            <field name="arrivee_id"/>
                            <field name="type_transmission" readonly="1"/>
                        </group>
                        <group string="Recipient">
                            <field name="organisme_id"
                                   domain="[('type_organisme','=','interne')]"/>
                            <field name="destinataire_nom"/>
                            <field name="responsable_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Instruction">
                            <field name="instruction_id"/>
                            <field name="instruction"/>
                        </group>
                        <group string="Dates">
                            <field name="date_transmission"/>
                            <field name="date_echeance"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         TRANSMISSION — RECHERCHE
    ══════════════════════════════════════════════════ -->
    <record id="view_boc_transmission_search" model="ir.ui.view">
        <field name="name">boc.transmission.search</field>
        <field name="model">boc.transmission</field>
        <field name="arch" type="xml">
            <search>
                <field name="arrivee_id" string="Mail"/>
                <field name="organisme_id" string="Department"/>
                <separator/>
                <filter name="en_attente" string="Pending"
                        domain="[('state','=','en_attente')]"/>
                <filter name="transfere" string="Transferred"
                        domain="[('state','=','transfere')]"/>
                <filter name="traite" string="Processed"
                        domain="[('state','=','traite')]"/>
                <separator/>
                <filter name="interne" string="Internal"
                        domain="[('type_transmission','=','interne')]"/>
                <filter name="externe" string="External"
                        domain="[('type_transmission','=','externe')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by':'type_transmission'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_organisme" string="Department" context="{'group_by':'organisme_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ACTIONS — CDC : Diffusion courriers aux services
    ══════════════════════════════════════════════════ -->

    <!-- Toutes les transmissions -->
    <record id="action_boc_transmission" model="ir.actions.act_window">
        <field name="name">Toutes les transmissions</field>
        <field name="res_model">boc.transmission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_transmission_search"/>
    </record>

    <!-- CDC : جدول الواردات الداخلية المحولة — Internes transférées -->
    <record id="action_boc_transmission_transferees" model="ir.actions.act_window">
        <field name="name">Transmissions internes transférées</field>
        <field name="res_model">boc.transmission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_transmission_search"/>
        <field name="domain">[('type_transmission','=','interne'),('state','in',['transfere','accuse','traite'])]</field>
        <field name="context">{'search_default_interne': 1, 'search_default_transfere': 1}</field>
    </record>

    <!-- CDC : جدول الواردات الداخلية غير المحولة — Internes non transférées -->
    <record id="action_boc_transmission_non_transferees" model="ir.actions.act_window">
        <field name="name">Transmissions internes non transférées</field>
        <field name="res_model">boc.transmission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_transmission_search"/>
        <field name="domain">[('type_transmission','=','interne'),('state','=','en_attente')]</field>
        <field name="context">{'search_default_interne': 1, 'search_default_en_attente': 1}</field>
    </record>

    <!-- CDC : جدول الواردات الخارجية المحولة — Externes réalisées -->
    <record id="action_boc_transmission_externes_transferees" model="ir.actions.act_window">
        <field name="name">Transmissions externes réalisées</field>
        <field name="res_model">boc.transmission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_transmission_search"/>
        <field name="domain">[('type_transmission','=','externe'),('state','in',['transfere','accuse','traite'])]</field>
        <field name="context">{'search_default_externe': 1, 'search_default_transfere': 1}</field>
    </record>

    <!-- CDC : جدول الواردات الخارجية غير المحولة — Externes non réalisées -->
    <record id="action_boc_transmission_externes_non_transferees" model="ir.actions.act_window">
        <field name="name">Transmissions externes non réalisées</field>
        <field name="res_model">boc.transmission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_boc_transmission_search"/>
        <field name="domain">[('type_transmission','=','externe'),('state','=','en_attente')]</field>
        <field name="context">{'search_default_externe': 1, 'search_default_en_attente': 1}</field>
    </record>

</odoo>