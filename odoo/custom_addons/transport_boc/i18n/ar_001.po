#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_bordereau_form
msgid ""
"<strong>Courriers externes non transférés</strong> — Courriers externes\n"
"                        enregistrés mais dont la transmission aux services est encore en attente."
msgstr "مراسلات خارجية غير محوّلة</strong> — مراسلات خارجية\n"
"                        مسجَّلة لم يتم تحويلها بعد إلى المصالح."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_bordereau_form
msgid ""
"<strong>Courriers externes transférés</strong> — Liste des courriers\n"
"                        externes dont la diffusion aux services concernés a été réalisée."
msgstr "مراسلات خارجية محوّلة</strong> — قائمة المراسلات\n"
"                        الخارجية التي تم توزيعها على المصالح المعنية."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_bordereau_form
msgid ""
"<strong>Courriers internes non transférés</strong> — Courriers internes\n"
"                        enregistrés mais dont la transmission aux services est encore en attente."
msgstr "مراسلات داخلية غير محوّلة</strong> — مراسلات داخلية\n"
"                        مسجَّلة لم يتم تحويلها بعد إلى المصالح."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_bordereau_form
msgid ""
"<strong>Courriers internes transférés</strong> — Liste des courriers\n"
"                        internes dont la diffusion aux services a été effectuée (état : Transféré,\n"
"                        Accusé de réception ou Traité)."
msgstr "مراسلات داخلية محوّلة</strong> — قائمة المراسلات\n"
"                        الداخلية التي تم توزيعها (الحالة: محوَّل، وصل استلام أو معالَج)."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_rapport_delais_form
msgid ""
"<strong>Courriers échus</strong> — Liste des courriers sans suite\n"
"                        dont la date d'échéance est dépassée à la date du jour."
msgstr "مراسلات منتهية الأجل</strong> — قائمة المراسلات بدون متابعة\n"
"                        التي تجاوز أجلها تاريخ اليوم."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_rapport_delais_form
msgid ""
"<strong>Dépassement de délai</strong> — Liste des courriers traités\n"
"                        mais dont la réponse a été fournie après la date d'échéance."
msgstr "تجاوز الأجل</strong> — قائمة المراسلات المعالَجة\n"
"                        لكن الرد أُرسل بعد تاريخ الاستحقاق."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_arrivee_form
msgid ""
"<strong>Information :</strong> Les factures sont associées aux courriers externes uniquement.\n"
"                        Veuillez changer le type de courrier si nécessaire."
msgstr "معلومة :</strong> الفواتير مرتبطة بالمراسلات الخارجية فقط.\n"
"                        يُرجى تغيير نوع المراسلة إذا لزم الأمر."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_arrivee_form
msgid ""
"<strong>Rappel :</strong> Ce courrier nécessite une réponse.\n"
"                        Date d'échéance :"
msgstr "تذكير :</strong> هذه المراسلة تستلزم رداً.\n"
"                        تاريخ الاستحقاق :"

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_periodique_form
msgid ""
"<strong>Rappel :</strong> L'échéance de ce courrier périodique approche.\n"
"                        Prochaine échéance :"
msgstr "تذكير :</strong> يقترب أجل هذه المراسلة الدورية.\n"
"                        الأجل القادم :"

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_bordereau_form
msgid ""
"<strong>Rappels échéance (mi-délai)</strong> — Courriers nécessitant\n"
"                        une réponse, non encore traités, avec calcul du délai restant.\n"
"                        Inclut un récapitulatif des alertes (en retard / urgent / en cours)."
msgstr "تذكيرات الأجل (منتصف المهلة)</strong> — مراسلات تستلزم\n"
"                        رداً، لم تعالَج بعد، مع حساب الأجل المتبقي.\n"
"                        يتضمن ملخص التنبيهات (متأخر / عاجل / جارٍ)."

#. module: transport_boc
#: model_terms:ir.ui.view,arch_db:transport_boc.view_boc_wizard_rapport_delais_form
msgid ""
"<strong>Édition des délais</strong> — Tableau complet de tous les courriers\n"
"                        avec calcul du délai de traitement et statut (dans les délais / hors délai / échu).\n"
"                        Inclut les statistiques globales."
msgstr "طباعة الآجال</strong> — جدول شامل لجميع المراسلات\n"
"                        مع حساب أجل المعالجة والحالة (في الأجل / خارج الأجل / منتهي).\n"
"                        يتضمن الإحصائيات العامة."

