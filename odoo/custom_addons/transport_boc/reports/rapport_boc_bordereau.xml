                                <thead style="background:#fff3cd;">
                                    <tr>
                                        <th style="width:9%">N° Arrivée</th>
                                        <th style="width:11%">Date arrivée</th>
                                        <th style="width:13%">Expéditeur</th>
                                        <th style="width:19%">Objet</th>
                                        <th style="width:11%">Type courrier</th>
                                        <th style="width:14%">Service destinataire</th>
                                        <th style="width:11%">Responsable</th>
                                        <th style="width:12%">Instruction</th>
                                        <th style="width:10%">Date trans. prévue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lignes" t-as="l">
                                        <tr>
                                            <td><t t-esc="l['arrivee_num']"/></td>
                                            <td><t t-esc="l['arrivee_date']"/></td>
                                            <td><t t-esc="l['expediteur']"/></td>
                                            <td><t t-esc="l['arrivee_sujet']"/></td>
                                            <td><t t-esc="l['type_courrier']"/></td>
                                            <td><t t-esc="l['destinataire']"/></td>
                                            <td><t t-esc="l['responsable']"/></td>
                                            <td><t t-esc="l['instruction']"/></td>
                                            <td><t t-esc="l['date_echeance']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background:#f8f9fa;">
                                    <tr>
                                        <td colspan="8" class="fw-bold">Total en attente</td>
                                        <td class="fw-bold text-center">
                                            <t t-esc="len(lignes)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <p>Agent BOC</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Responsable BOC</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Directeur</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>


