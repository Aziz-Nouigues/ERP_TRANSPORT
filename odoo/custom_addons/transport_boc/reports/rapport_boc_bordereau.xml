<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         RAPPORT 1 — BORDEREAU TRANSMISSIONS INTERNES TRANSFÉRÉES
         CDC : Courriers internes transférés aux services
    ══════════════════════════════════════════════════ -->
    <record id="action_bordereau_interne_transfere" model="ir.actions.report">
        <field name="name">Bordereau — Internes transférés</field>
        <field name="model">boc.wizard.bordereau</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_boc.bordereau_interne_transfere</field>
        <field name="report_file">transport_boc.bordereau_interne_transfere</field>
    </record>

    <template id="bordereau_interne_transfere">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wiz">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="text-center mb-4">
                            <h2>قائمة الإرساليّات الداخلية المُحوَّلة</h2>
                            <h3>Bordereau des Courriers Internes Transférés</h3>
                            <p style="font-size:12px; color:#555;">
                                Période : <t t-esc="wiz.date_debut"/> au <t t-esc="wiz.date_fin"/>
                            </p>
                        </div>

                        <t t-set="lignes" t-value="wiz._get_transmissions_internes_transferees()"/>

                        <t t-if="not lignes">
                            <p class="text-center text-muted mt-4">
                                Aucun courrier interne transféré sur cette période.
                            </p>
                        </t>

                        <t t-if="lignes">
                            <table class="table table-bordered table-sm" style="font-size:10px;">
                                <thead style="background:#d1ecf1;">
                                    <tr>
                                        <th style="width:8%">N° Arrivée</th>
                                        <th style="width:10%">Date arrivée</th>
                                        <th style="width:12%">Expéditeur</th>
                                        <th style="width:18%">Objet</th>
                                        <th style="width:10%">Type courrier</th>
                                        <th style="width:14%">Service destinataire</th>
                                        <th style="width:10%">Responsable</th>
                                        <th style="width:12%">Instruction</th>
                                        <th style="width:9%">Date trans.</th>
                                        <th style="width:7%">État</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lignes" t-as="l">
                                        <tr>
                                            <td><t t-esc="l['arrivee_num']"/></td>
                                            <td><t t-esc="l['arrivee_date']"/></td>
                                            <td><t t-esc="l['expediteur']"/></td>
                                            <td><t t-esc="l['arrivee_sujet']"/></td>
                                            <td><t t-esc="l['type_courrier']"/></td>
                                            <td><t t-esc="l['destinataire']"/></td>
                                            <td><t t-esc="l['responsable']"/></td>
                                            <td><t t-esc="l['instruction']"/></td>
                                            <td><t t-esc="l['date_transmission']"/></td>
                                            <td><t t-esc="l['state']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background:#f8f9fa;">
                                    <tr>
                                        <td colspan="9" class="fw-bold">Total</td>
                                        <td class="fw-bold text-center">
                                            <t t-esc="len(lignes)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <p>Agent BOC</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Responsable BOC</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Directeur</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>


