    <!-- ══════════════════════════════════════════════════
         RAPPORT 5 — COURRIERS NÉCESSITANT UNE ACTION (RAPPEL MI-DÉLAI)
         CDC : Bordereau suivi courrier avec note de rappel (mi-délai)
    ══════════════════════════════════════════════════ -->
    <record id="action_bordereau_rappel_echeance" model="ir.actions.report">
        <field name="name">Bordereau — Rappels échéance (mi-délai)</field>
        <field name="model">boc.wizard.bordereau</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_boc.bordereau_rappel_echeance</field>
        <field name="report_file">transport_boc.bordereau_rappel_echeance</field>
    </record>

    <template id="bordereau_rappel_echeance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wiz">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="text-center mb-4">
                            <h2>قائمة الإرساليّات المطلوب التصرّف فيها</h2>
                            <h3>Bordereau des Courriers Nécessitant une Action</h3>
                            <p style="font-size:12px; color:#555;">
                                Courriers en attente de réponse — Note de rappel à mi-délai<br/>
                                Période d'arrivée : <t t-esc="wiz.date_debut"/> au <t t-esc="wiz.date_fin"/>
                            </p>
                        </div>

                        <t t-set="courriers" t-value="wiz._get_courriers_rappel_echeance()"/>

                        <t t-if="not courriers">
                            <p class="text-center text-muted mt-4">
                                Aucun courrier en attente d'action sur cette période.
                            </p>
                        </t>

                        <t t-if="courriers">
                            <!-- Compteurs par niveau d'alerte -->
                            <t t-set="nb_retard"  t-value="len([c for c in courriers if c['alerte'] == 'danger'])"/>
                            <t t-set="nb_urgent"  t-value="len([c for c in courriers if c['alerte'] == 'warning'])"/>
                            <t t-set="nb_normal"  t-value="len([c for c in courriers if c['alerte'] == 'info'])"/>

                            <table class="table table-bordered" style="font-size:11px; margin-bottom:14px; width:60%;">
                                <thead style="background:#e2e3e5;">
                                    <tr>
                                        <th colspan="2" class="text-center">Récapitulatif des alertes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="color:red; font-weight:bold;">En retard (échéance dépassée)</td>
                                        <td class="text-center" style="color:red; font-weight:bold;">
                                            <t t-esc="nb_retard"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="color:#856404; font-weight:bold;">Urgent (≤ 3 jours restants)</td>
                                        <td class="text-center" style="color:#856404; font-weight:bold;">
                                            <t t-esc="nb_urgent"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>En cours</td>
                                        <td class="text-center"><t t-esc="nb_normal"/></td>
                                    </tr>
                                    <tr style="background:#f8f9fa;">
                                        <td class="fw-bold">Total courriers en attente</td>
                                        <td class="text-center fw-bold"><t t-esc="len(courriers)"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <table class="table table-bordered table-sm" style="font-size:10px;">
                                <thead style="background:#cce5ff;">
                                    <tr>
                                        <th style="width:9%">N° Arrivée</th>
                                        <th style="width:10%">Date arrivée</th>
                                        <th style="width:13%">Expéditeur</th>
                                        <th style="width:19%">Objet</th>
                                        <th style="width:10%">Type</th>
                                        <th style="width:10%">Date échéance</th>
                                        <th style="width:10%">Date rappel</th>
                                        <th style="width:10%">Jours restants</th>
                                        <th style="width:9%">État courrier</th>
                                        <th style="width:10%">Alerte</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="courriers" t-as="c">
                                        <tr>
                                            <td><t t-esc="c['name']"/></td>
                                            <td><t t-esc="c['date_arrivee']"/></td>
                                            <td><t t-esc="c['expediteur']"/></td>
                                            <td><t t-esc="c['sujet']"/></td>
                                            <td><t t-esc="c['type_courrier']"/></td>
                                            <td>
                                                <t t-if="c['alerte'] == 'danger'">
                                                    <span style="color:red; font-weight:bold;">
                                                        <t t-esc="c['date_echeance']"/>
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="c['date_echeance']"/>
                                                </t>
                                            </td>
                                            <td><t t-esc="c['date_rappel']"/></td>
                                            <td style="text-align:center;">
                                                <t t-if="c['jours_restants'] &lt; 0">
                                                    <span style="color:red; font-weight:bold;">
                                                        <t t-esc="c['jours_restants']"/> j
                                                    </span>
                                                </t>
                                                <t t-elif="c['jours_restants'] &lt;= 3">
                                                    <span style="color:#856404; font-weight:bold;">
                                                        <t t-esc="c['jours_restants']"/> j
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="c['jours_restants']"/> j
                                                </t>
                                            </td>
                                            <td><t t-esc="c['state']"/></td>
                                            <td>
                                                <t t-if="c['alerte'] == 'danger'">
                                                    <span style="color:red; font-weight:bold;">En retard</span>
                                                </t>
                                                <t t-elif="c['alerte'] == 'warning'">
                                                    <span style="color:#856404; font-weight:bold;">Urgent</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:#004085;">En cours</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <p style="font-size:10px; color:#666; margin-top:8px; font-style:italic;">
                                * Date de rappel = mi-délai entre la date d'arrivée et la date d'échéance.
                                Les courriers marqués "En retard" ont dépassé leur date d'échéance sans réponse.
                            </p>
                        </t>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <p>Agent BOC</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Responsable BOC</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Directeur</p><br/><br/>
                                <p>___________________________</p>
                            </div>
                        </div>

                    </div>
                </t>
