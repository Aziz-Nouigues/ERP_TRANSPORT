<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         RAPPORT BORDEREAU COURRIER ARRIVÉE
    ══════════════════════════════════════════════════ -->
    <record id="action_rapport_boc_arrivee" model="ir.actions.report">
        <field name="name">Bordereau Courrier Arrivée</field>
        <field name="model">boc.courrier.arrivee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_boc.rapport_boc_arrivee</field>
        <field name="report_file">transport_boc.rapport_boc_arrivee</field>
        <field name="binding_model_id" ref="model_boc_courrier_arrivee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="rapport_boc_arrivee">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="text-center mb-4">
                            <h2>بطاقة البريد الوارد — Bordereau Courrier Arrivée</h2>
                        </div>

                        <!-- Entête du courrier -->
                        <table class="table table-bordered" style="font-size:12px;">
                            <tbody>
                                <tr>
                                    <td class="fw-bold" style="width:30%">N° d'ordre</td>
                                    <td><t t-esc="o.name"/></td>
                                    <td class="fw-bold" style="width:30%">Année</td>
                                    <td><t t-esc="o.annee_exercice"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Date / Heure d'arrivée</td>
                                    <td><t t-esc="o.date_arrivee"/></td>
                                    <td class="fw-bold">Date du courrier</td>
                                    <td><t t-esc="o.date_courrier or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Type d'arrivée</td>
                                    <td><t t-esc="dict(o.fields_get(['type_arrivee'])['type_arrivee']['selection'])[o.type_arrivee]"/></td>
                                    <td class="fw-bold">Nature du courrier</td>
                                    <td><t t-esc="o.type_courrier_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Expéditeur</td>
                                    <td><t t-esc="o.organisme_id.name or o.expediteur_nom or '-'"/></td>
                                    <td class="fw-bold">Réf. expéditeur</td>
                                    <td><t t-esc="o.reference_expediteur or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Objet / Sujet</td>
                                    <td colspan="3"><t t-esc="o.sujet"/></td>
                                </tr>
                                <tr t-if="o.necessite_reponse">
                                    <td class="fw-bold">Date d'échéance</td>
                                    <td><t t-esc="o.date_echeance or '-'"/></td>
                                    <td class="fw-bold">Date de rappel</td>
                                    <td><t t-esc="o.date_rappel or '-'"/></td>
                                </tr>
                                <tr t-if="o.est_facture">
                                    <td class="fw-bold">Référence facture</td>
                                    <td><t t-esc="o.reference_facture or '-'"/></td>
                                    <td class="fw-bold">Fournisseur</td>
                                    <td><t t-esc="o.fournisseur or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Tableau des diffusions -->
                        <t t-if="o.transmission_ids">
                            <h4 class="mt-3">Diffusions / Transmissions</h4>
                            <table class="table table-bordered table-sm" style="font-size:11px;">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>Service / Direction</th>
                                        <th>Instruction</th>
                                        <th>Date transmission</th>
                                        <th>Date échéance</th>
                                        <th>État</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.transmission_ids" t-as="t">
                                        <tr>
                                            <td><t t-esc="t.organisme_id.name or t.destinataire_nom or '-'"/></td>
                                            <td><t t-esc="t.instruction or '-'"/></td>
                                            <td><t t-esc="t.date_transmission"/></td>
                                            <td><t t-esc="t.date_echeance or '-'"/></td>
                                            <td><t t-esc="dict(t.fields_get(['state'])['state']['selection'])[t.state]"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Zone signatures -->
                        <div class="row mt-4">
                            <div class="col-6 text-center">
                                <p>Agent BOC</p>
                                <br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>Responsable BOC</p>
                                <br/><br/>
                                <p>___________________________</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         RAPPORT BORDEREAU COURRIER DÉPART
    ══════════════════════════════════════════════════ -->
    <record id="action_rapport_boc_depart" model="ir.actions.report">
        <field name="name">Bordereau Courrier Départ</field>
        <field name="model">boc.courrier.depart</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_boc.rapport_boc_depart</field>
        <field name="report_file">transport_boc.rapport_boc_depart</field>
        <field name="binding_model_id" ref="model_boc_courrier_depart"/>
        <field name="binding_type">report</field>
    </record>

    <template id="rapport_boc_depart">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="text-center mb-4">
                            <h2>بطاقة البريد الصادر — Bordereau Courrier Départ</h2>
                        </div>

                        <table class="table table-bordered" style="font-size:12px;">
                            <tbody>
                                <tr>
                                    <td class="fw-bold" style="width:30%">N° d'ordre</td>
                                    <td><t t-esc="o.name"/></td>
                                    <td class="fw-bold" style="width:30%">Date de départ</td>
                                    <td><t t-esc="o.date_depart"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Type</td>
                                    <td><t t-esc="dict(o.fields_get(['type_depart'])['type_depart']['selection'])[o.type_depart]"/></td>
                                    <td class="fw-bold">Support</td>
                                    <td><t t-esc="dict(o.fields_get(['support'])['support']['selection'])[o.support]"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Destinataire</td>
                                    <td><t t-esc="o.organisme_id.name or o.destinataire_nom or '-'"/></td>
                                    <td class="fw-bold">Nature du courrier</td>
                                    <td><t t-esc="o.type_courrier_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Objet / Sujet</td>
                                    <td colspan="3"><t t-esc="o.sujet"/></td>
                                </tr>
                                <tr t-if="o.arrivee_id">
                                    <td class="fw-bold">En réponse à</td>
                                    <td colspan="3"><t t-esc="o.arrivee_id.name"/> — <t t-esc="o.arrivee_id.sujet"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Service expéditeur</td>
                                    <td><t t-esc="o.service_expediteur or '-'"/></td>
                                    <td class="fw-bold">Responsable</td>
                                    <td><t t-esc="o.responsable_id.name or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6 text-center">
                                <p>Agent BOC</p>
                                <br/><br/>
                                <p>___________________________</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>Responsable BOC</p>
                                <br/><br/>
                                <p>___________________________</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>