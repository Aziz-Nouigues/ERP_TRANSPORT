<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Séquence Courrier Arrivée : ARR/2026/0001 -->
        <record id="seq_courrier_arrivee" model="ir.sequence">
            <field name="name">Courrier Arrivée</field>
            <field name="code">boc.courrier.arrivee</field>
            <field name="prefix">ARR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Séquence Courrier Départ : DEP/2026/0001 -->
        <record id="seq_courrier_depart" model="ir.sequence">
            <field name="name">Courrier Départ</field>
            <field name="code">boc.courrier.depart</field>
            <field name="prefix">DEP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>