<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_fleet_etat" model="ir.ui.view">
        <field name="name">res.config.settings.fleet.etat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     data-string="Parc bus — Transport"
                     string="Parc bus — Transport"
                     data-key="fleet_etat_bus">

                    <h2>Parc bus — Transport terrestre</h2>

                    <div class="row mt16 o_settings_container">

                        <!-- Alerte immobilisation -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="fleet_alerte_immobilisation_jours"
                                       string="Alerte immobilisation"/>
                                <div class="text-muted">
                                    Déclencher une alerte dans le chatter si un bus reste
                                    indisponible plus de N jours. Mettre 0 pour désactiver.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label for="fleet_alerte_immobilisation_jours"
                                               class="col-lg-4 o_light_label"
                                               string="Nombre de jours"/>
                                        <field name="fleet_alerte_immobilisation_jours"
                                               class="col-lg-2"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Motif obligatoire au retour en service -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="fleet_motif_retour_service_obligatoire"
                                       widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="fleet_motif_retour_service_obligatoire"
                                       string="Motif obligatoire au retour en service"/>
                                <div class="text-muted">
                                    Exige un motif détaillé dans le wizard lors du passage
                                    à l'état "En service" après une panne ou maintenance.
                                </div>
                            </div>
                        </div>

                        <!-- Impression auto -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="fleet_impression_auto_changement"
                                       widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="fleet_impression_auto_changement"
                                       string="Imprimer fiche à chaque changement d'état"/>
                                <div class="text-muted">
                                    Génère automatiquement la fiche PDF du véhicule
                                    à chaque confirmation du wizard de changement d'état.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Action menu Configuration > Paramètres dans le menu Parc Bus -->
    <record id="action_fleet_etat_settings" model="ir.actions.act_window">
        <field name="name">Paramètres parc bus</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'fleet_etat_bus'}</field>
    </record>

</odoo>
