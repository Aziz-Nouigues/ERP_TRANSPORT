<odoo>
<!--  ══════════════════════════════════════════════════════════
         1. VUE LISTE HISTORIQUE ÉTATS
    ══════════════════════════════════════════════════════════════  -->
<record id="view_fleet_historique_etat_list" model="ir.ui.view">
<field name="name">fleet.vehicle.historique.etat.list</field>
<field name="model">fleet.vehicle.historique.etat</field>
<field name="arch" type="xml">
<list string="Historique états" create="false" decoration-danger="state_id.name in ['En panne', 'Hors service', 'Réformé']" decoration-warning="state_id.name == 'En maintenance'" decoration-success="state_id.name == 'En service'">
<field name="vehicle_id" string="Véhicule" optional="show"/>
<field name="date_debut"/>
<field name="date_fin"/>
<field name="duree_jours" string="Durée (j)"/>
<field name="state_id" widget="badge" decoration-danger="state_id.name in ['En panne', 'Hors service']" decoration-warning="state_id.name == 'En maintenance'" decoration-success="state_id.name == 'En service'"/>
<field name="priorite" widget="priority"/>
<field name="cause"/>
<field name="responsable_id"/>
<field name="notes" optional="hide"/>
</list>
</field>
</record>
<!--  ══════════════════════════════════════════════════════════
         2. VUE LISTE BUS
    ══════════════════════════════════════════════════════════════  -->
<record id="view_fleet_vehicle_parc_list" model="ir.ui.view">
<field name="name">fleet.vehicle.parc.list</field>
<field name="model">fleet.vehicle</field>
<field name="arch" type="xml">
<list string="Parc Véhicules" decoration-danger="state_id.name in ['En panne', 'Hors service', 'Réformé']" decoration-warning="state_id.name == 'En maintenance'" decoration-success="state_id.name == 'En service'">
<field name="name" string="Immatriculation"/>
<field name="internal_code" string="Code interne" optional="show"/>
<field name="bus_type" string="Type" optional="show"/>
<field name="activity_type" string="Activité" optional="show"/>
<field name="type_vehicule" string="Type de service" widget="badge" decoration-info="type_vehicule == 'urbain'" decoration-warning="type_vehicule == 'interurbain'" decoration-secondary="type_vehicule == 'mixte'" optional="show"/>
<field name="transport_agency" string="Agence" optional="show"/>
<field name="state_id" widget="badge" decoration-danger="state_id.name in ['En panne', 'Hors service', 'Réformé']" decoration-warning="state_id.name == 'En maintenance'" decoration-success="state_id.name == 'En service'" string="État"/>
<field name="state_date_debut" string="En cet état depuis" optional="show"/>
<field name="odometer_status" widget="badge" decoration-danger="odometer_status == 'broken'" decoration-warning="odometer_status == 'replaced'" decoration-success="odometer_status == 'ok'" string="Compteur"/>
<field name="state_cause" string="Cause" optional="show"/>
</list>
</field>
</record>
<!--  ══════════════════════════════════════════════════════════
         3. VUE RECHERCHE
    ══════════════════════════════════════════════════════════════  -->
<record id="view_fleet_vehicle_parc_search" model="ir.ui.view">
<field name="name">fleet.vehicle.parc.search</field>
<field name="model">fleet.vehicle</field>
<field name="arch" type="xml">
<search string="Rechercher un bus">
<field name="name" string="Immatriculation"/>
<field name="internal_code" string="Code interne"/>
<field name="transport_agency" string="Agence"/>
<field name="state_id" string="État"/>
<filter name="filter_en_service" string="En service" domain="[('state_id.name', '=', 'En service')]"/>
<filter name="filter_en_panne" string="En panne" domain="[('state_id.name', '=', 'En panne')]"/>
<filter name="filter_en_maintenance" string="En maintenance" domain="[('state_id.name', '=', 'En maintenance')]"/>
<filter name="filter_hors_service" string="Hors service / Réformé" domain="[('state_id.name', 'in', ['Hors service', 'Réformé'])]"/>
<separator/>
<filter name="filter_compteur_panne" string="Compteur en panne" domain="[('odometer_status', '=', 'broken')]"/>
<filter name="filter_compteur_remplace" string="Compteur remplacé" domain="[('odometer_status', '=', 'replaced')]"/>
<separator/>
<filter name="filter_urbain" string="Urbain" domain="[('type_vehicule', '=', 'urbain')]"/>
<filter name="filter_interurbain" string="Interurbain" domain="[('type_vehicule', '=', 'interurbain')]"/>
<filter name="filter_mixte" string="Mixte" domain="[('type_vehicule', '=', 'mixte')]"/>
<separator/>
<filter name="group_state" string="État" context="{'group_by': 'state_id'}"/>
<filter name="group_agency" string="Agence" context="{'group_by': 'transport_agency'}"/>
<filter name="group_type" string="Type de bus" context="{'group_by': 'bus_type'}"/>
<filter name="group_service" string="Type de service" context="{'group_by': 'type_vehicule'}"/>
<filter name="group_odometer" string="État compteur" context="{'group_by': 'odometer_status'}"/>
</search>
</field>
</record>
<!--  ══════════════════════════════════════════════════════════
         4. ACTIONS FENÊTRES
    ══════════════════════════════════════════════════════════════  -->
<record id="action_fleet_parc_complet" model="ir.actions.act_window">
<field name="name">Parc Véhicules</field>
<field name="res_model">fleet.vehicle</field>
<field name="view_mode">list,form,kanban</field>
<field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_fleet_vehicle_parc_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('fleet.fleet_vehicle_view_form')}), (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_fleet_vehicle_parc_kanban')}), ]"/>
<field name="search_view_id" ref="view_fleet_vehicle_parc_search"/>
<field name="context">{}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face">Aucun véhicule dans le parc.</p>
</field>
</record>
<record id="action_fleet_en_panne" model="ir.actions.act_window">
<field name="name">Bus en panne</field>
<field name="res_model">fleet.vehicle</field>
<field name="view_mode">list,form</field>
<field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_fleet_vehicle_parc_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('fleet.fleet_vehicle_view_form')}), ]"/>
<field name="domain">[('state_id.name', 'in', ['En panne', 'Hors service', 'Réformé'])]</field>
<field name="search_view_id" ref="view_fleet_vehicle_parc_search"/>
</record>
<record id="action_fleet_compteur_panne" model="ir.actions.act_window">
<field name="name">Compteur défaillant</field>
<field name="res_model">fleet.vehicle</field>
<field name="view_mode">list,form</field>
<field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_fleet_vehicle_parc_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('fleet.fleet_vehicle_view_form')}), ]"/>
<field name="domain">[('odometer_status', '=', 'broken')]</field>
<field name="search_view_id" ref="view_fleet_vehicle_parc_search"/>
</record>
<record id="action_fleet_historique_global" model="ir.actions.act_window">
<field name="name">Historique des états</field>
<field name="res_model">fleet.vehicle.historique.etat</field>
<field name="view_mode">list,form</field>
<field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_fleet_historique_etat_list')}), ]"/>
<field name="context">{'group_by': 'vehicle_id'}</field>
</record>
<!--  ══════════════════════════════════════════════════════════
         5. EXTENSION FORMULAIRE fleet.vehicle
         Structure Odoo 19 fleet standard :
           <form>
             <header>
               <field name="state_id" widget="statusbar"/>  ← ICI, dans le header
             </header>
             <sheet>
               <div name="button_box"/>
               <div class="oe_title">...</div>
               <group name="main_group">...</group>
               <notebook>...</notebook>
             </sheet>
           </form>
         ⚠ XPath sur //field[@name='state_id'] cible le header → hors formulaire.
         On cible //notebook (position="before") pour rester dans le sheet.
    ══════════════════════════════════════════════════════════════  -->
<record id="view_fleet_vehicle_form_etat_inherit" model="ir.ui.view">
<field name="name">fleet.vehicle.form.etat.inherit</field>
<field name="model">fleet.vehicle</field>
<field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
<field name="arch" type="xml">
<!--  ① Boutons dans la barre de header  -->
<xpath expr="//header" position="inside">
<button name="action_changer_etat" type="object" string="Changer l'état" class="oe_highlight" icon="fa-exchange"/>
<button name="action_imprimer_fiche" type="object" string="Imprimer fiche" icon="fa-print"/>
</xpath>
<!--  ② Stat button unique — dans le button_box existant  -->
<xpath expr="//div[@name='button_box']" position="inside">
<button name="action_voir_historique" type="object" class="oe_stat_button" icon="fa-history">
<field name="nb_historique" widget="statinfo" string="Changements d'état"/>
</button>
</xpath>
<!--  ④ Alertes état + Type de service + Compteur — avant le notebook  -->
<xpath expr="//notebook" position="before">
<!--  Bandeau d'alerte état  -->
<div class="alert alert-danger mb-2 p-2" invisible="state_id.name not in ['En panne', 'Hors service', 'Réformé']">
<i class="fa fa-ban me-1"/>
Ce véhicule est
<strong>indisponible</strong>
— il ne peut pas être affecté à une tournée.
</div>
<div class="alert alert-warning mb-2 p-2" invisible="state_id.name != 'En maintenance'">
<i class="fa fa-wrench me-1"/>
Ce véhicule est
<strong>en maintenance</strong>
.
</div>
<div class="alert alert-success mb-2 p-2" invisible="state_id.name != 'En service'">
<i class="fa fa-check-circle me-1"/>
Ce véhicule est
<strong>en service</strong>
et disponible.
</div>
<!--  Ligne 2 : Type de service | Compteur kilométrique  -->
<group col="2">
<group string="Type de service">
<field name="type_vehicule" widget="radio" string=" "/>
</group>
<group string="Compteur kilométrique">
<field name="odometer_status" widget="badge" decoration-danger="odometer_status == 'broken'" decoration-warning="odometer_status == 'replaced'" decoration-success="odometer_status == 'ok'" string="État du compteur"/>
<field name="odometer_replacement_date" string="Date remplacement" invisible="odometer_status == 'ok'"/>
<field name="odometer_old_value" string="Ancienne valeur (km)" invisible="odometer_status == 'ok'"/>
<div class="alert alert-warning mt-1 mb-0 p-2" colspan="2" invisible="odometer_status != 'broken'">
<i class="fa fa-tachometer me-1"/>
Compteur
<strong>en panne</strong>
— kilométrage estimé automatiquement.
</div>
</group>
</group>
<!--  ③ Groupe État actuel — ajouté dans le même xpath "before notebook"  -->
<group string="État actuel" invisible="not state_id">
<field name="state_id" widget="badge"
       decoration-danger="state_id.name in ['En panne', 'Hors service', 'Réformé']"
       decoration-warning="state_id.name == 'En maintenance'"
       decoration-success="state_id.name == 'En service'"
       string="État" readonly="1"/>
<field name="state_date_debut" readonly="1" string="En cet état depuis"/>
<field name="state_duree_jours" readonly="1" string="Durée (jours)"/>
<field name="state_cause" string="Cause / Motif" placeholder="Aucune cause renseignée" readonly="1"/>
</group>
</xpath>
<!--  ⑤ Masquer next_assignation_date si le champ existe encore en Odoo 19  -->
<xpath expr="//field[@name='next_assignation_date']" position="replace"/>
<!--  ④ Onglet Historique des états  -->
<xpath expr="//notebook" position="inside">
<page string="Historique des états" name="historique_etat">
<field name="historique_etat_ids" mode="list" readonly="1">
<list string="Historique" decoration-danger="state_id.name in ['En panne', 'Hors service', 'Réformé']" decoration-warning="state_id.name == 'En maintenance'" decoration-success="state_id.name == 'En service'">
<field name="date_debut" string="Depuis"/>
<field name="date_fin" string="Jusqu'au"/>
<field name="duree_jours" string="Durée (j)"/>
<field name="state_id" widget="badge" decoration-danger="state_id.name in ['En panne', 'Hors service']" decoration-warning="state_id.name == 'En maintenance'" decoration-success="state_id.name == 'En service'"/>
<field name="priorite" widget="priority"/>
<field name="cause"/>
<field name="responsable_id" string="Par"/>
<field name="notes" optional="hide"/>
</list>
</field>
<div class="text-muted fst-italic p-2" invisible="nb_historique != 0">
Aucun changement d'état enregistré. Utilisez le bouton
<strong>"Changer l'état"</strong>
pour commencer.
</div>
<field name="nb_historique" invisible="1"/>
</page>
</xpath>
</field>
</record>
</odoo>