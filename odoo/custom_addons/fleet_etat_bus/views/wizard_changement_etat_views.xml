<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_changement_etat_form" model="ir.ui.view">
        <field name="name">fleet.wizard.changement.etat.form</field>
        <field name="model">fleet.wizard.changement.etat</field>
        <field name="arch" type="xml">
            <form string="Changer l'état du véhicule">
                <sheet>

                    <!-- État actuel (lecture seule) -->
                    <group string="État actuel" col="2">
                        <field name="vehicle_id" readonly="1"/>
                        <field name="state_actuel_id" readonly="1" widget="badge"
                               decoration-danger="state_actuel_id.name in ['En panne', 'Hors service', 'Réformé']"
                               decoration-warning="state_actuel_id.name == 'En maintenance'"
                               decoration-success="state_actuel_id.name == 'En service'"/>
                        <field name="state_date_debut_actuelle" readonly="1"
                               invisible="not state_actuel_id"/>
                        <field name="state_cause_actuelle" readonly="1"
                               invisible="not state_actuel_id"/>
                    </group>

                    <separator string="Nouveau changement d'état"/>

                    <!-- Nouvel état -->
                    <group col="2">
                        <field name="new_state_id" required="1"/>
                        <field name="priorite" widget="priority"/>
                        <field name="date_debut" required="1"/>
                    </group>
                    <group>
                        <field name="cause" required="1"
                               placeholder="Ex: Panne moteur ligne L12, Révision 50 000 km…"/>
                        <field name="notes"
                               placeholder="Observations complémentaires (optionnel)"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_confirmer" type="object"
                            string="Confirmer le changement"
                            class="oe_highlight"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
