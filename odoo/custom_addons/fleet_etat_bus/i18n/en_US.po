#. module: fleet_etat_bus
#: model_terms:ir.ui.view,arch_db:fleet_etat_bus.view_fleet_vehicle_form_etat_inherit
msgid ""
"<i class=\"fa fa-ban me-1\"/>\n"
"                    Ce véhicule est <strong>indisponible</strong> — il ne peut pas être affecté à une tournée."
msgstr ""
"<i class=\"fa fa-ban me-1\"/>\n"
"                    This vehicle is <strong>unavailable</strong> — it cannot be assigned to a route."

#. module: fleet_etat_bus
#: model_terms:ir.ui.view,arch_db:fleet_etat_bus.view_fleet_vehicle_form_etat_inherit
msgid ""
"<i class=\"fa fa-check-circle me-1\"/>\n"
"                    Ce véhicule est <strong>en service</strong>."
msgstr ""
"<i class=\"fa fa-check-circle me-1\"/>\n"
"                    This vehicle is <strong>in service</strong>."

#. module: fleet_etat_bus
#: model_terms:ir.ui.view,arch_db:fleet_etat_bus.view_fleet_vehicle_form_etat_inherit
msgid ""
"<i class=\"fa fa-tachometer me-1\"/>\n"
"                        Compteur <strong>en panne</strong> — le kilométrage sera estimé\n"
"                        automatiquement dans les tournées (Départ + Km prévus)."
msgstr ""
"<i class=\"fa fa-tachometer me-1\"/>\n"
"                        Odometer <strong>faulty</strong> — mileage will be estimated\n"
"                        automatically in routes (Departure + Planned km)."

#. module: fleet_etat_bus
#: model_terms:ir.ui.view,arch_db:fleet_etat_bus.view_fleet_vehicle_form_etat_inherit
msgid ""
"<i class=\"fa fa-wrench me-1\"/>\n"
"                    Ce véhicule est <strong>en maintenance</strong>."
msgstr ""
"<i class=\"fa fa-wrench me-1\"/>\n"
"                    This vehicle is <strong>under maintenance</strong>."

