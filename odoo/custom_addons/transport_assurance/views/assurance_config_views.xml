<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ COMPAGNIE D'ASSURANCE ════════════════════════════════ -->

    <!-- Vue Recherche -->
    <record id="view_assurance_compagnie_search" model="ir.ui.view">
        <field name="name">transport.assurance.compagnie.search</field>
        <field name="model">transport.assurance.compagnie</field>
        <field name="arch" type="xml">
            <search string="Recherche compagnie">
                <field name="name" string="Raison sociale"/>
                <field name="code" string="Code compagnie"/>
                <field name="ville"/>
                <field name="email"/>
                <separator/>
                <filter name="actives"   string="Actives"   domain="[('active','=',True)]"/>
                <filter name="inactives" string="Archivées" domain="[('active','=',False)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_ville" string="Ville"
                            context="{'group_by': 'ville'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Liste -->
    <record id="view_assurance_compagnie_list" model="ir.ui.view">
        <field name="name">transport.assurance.compagnie.list</field>
        <field name="model">transport.assurance.compagnie</field>
        <field name="arch" type="xml">
            <list string="Compagnies d'assurance">
                <field name="code"/>
                <field name="name"/>
                <field name="ville"/>
                <field name="contact_nom"/>
                <field name="telephone"/>
                <field name="email"/>
                <field name="nb_polices_bus"       string="Polices bus"/>
                <field name="nb_polices_chauffeur" string="Polices chauffeurs"/>
                <field name="nb_sinistres_ouverts" string="Sinistres ouverts"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_assurance_compagnie_form" model="ir.ui.view">
        <field name="name">transport.assurance.compagnie.form</field>
        <field name="model">transport.assurance.compagnie</field>
        <field name="arch" type="xml">
            <form string="Compagnie d'assurance">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archivée"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Raison sociale de la compagnie"/>
                        </h1>
                        <h2>
                            <field name="code"
                                   placeholder="Code court (ex : STAR, GAT, COMAR…)"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="numero_agrement"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Statistiques">
                            <field name="nb_polices_bus"       readonly="1"/>
                            <field name="nb_polices_chauffeur" readonly="1"/>
                            <field name="nb_sinistres_ouverts" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Coordonnées">
                            <field name="adresse"/>
                            <field name="ville"/>
                            <field name="telephone"/>
                            <field name="fax"/>
                            <field name="email"    widget="email"/>
                            <field name="site_web" widget="url"/>
                        </group>
                        <group string="Contact dédié">
                            <field name="contact_nom"/>
                            <field name="contact_poste"/>
                            <field name="contact_telephone"/>
                            <field name="contact_email" widget="email"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes internes…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_assurance_compagnie" model="ir.actions.act_window">
        <field name="name">Compagnies d'assurance</field>
        <field name="res_model">transport.assurance.compagnie</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assurance_compagnie_search"/>
        <field name="context">{'search_default_actives': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre première compagnie d'assurance
            </p>
            <p>
                Ajoutez les compagnies partenaires (STAR, GAT, COMAR, etc.)
                et gérez leurs coordonnées et contacts dédiés depuis cette vue.
            </p>
        </field>
    </record>

    <!-- ══ TYPES DE POLICES ══════════════════════════════════════ -->

    <!-- Vue Recherche -->
    <record id="view_assurance_type_search" model="ir.ui.view">
        <field name="name">transport.assurance.type.search</field>
        <field name="model">transport.assurance.type</field>
        <field name="arch" type="xml">
            <search string="Recherche type de police">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="obligatoires" string="Obligatoires"
                        domain="[('is_obligatoire','=',True)]"/>
                <filter name="actifs" string="Actifs"
                        domain="[('active','=',True)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_categorie" string="Catégorie"
                            context="{'group_by': 'categorie'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Liste -->
    <record id="view_assurance_type_list" model="ir.ui.view">
        <field name="name">transport.assurance.type.list</field>
        <field name="model">transport.assurance.type</field>
        <field name="arch" type="xml">
            <list string="Types de polices" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="categorie"/>
                <field name="is_obligatoire"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_assurance_type_form" model="ir.ui.view">
        <field name="name">transport.assurance.type.form</field>
        <field name="model">transport.assurance.type</field>
        <field name="arch" type="xml">
            <form string="Type de police">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="categorie"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="is_obligatoire"/>
                            <field name="base_legale"
                                   invisible="not is_obligatoire"/>
                        </group>
                    </group>
                    <field name="description"
                           placeholder="Description du type de police…"/>
                    <field name="notes" placeholder="Notes internes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_assurance_type" model="ir.actions.act_window">
        <field name="name">Types de polices</field>
        <field name="res_model">transport.assurance.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assurance_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier type de police
            </p>
            <p>
                Définissez les catégories de polices (RC, Tous Risques,
                Individuelle Accident, etc.).
            </p>
        </field>
    </record>

</odoo>
