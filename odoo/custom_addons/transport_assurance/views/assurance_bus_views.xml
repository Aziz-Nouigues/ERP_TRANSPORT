<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_assurance_bus_form" model="ir.ui.view">
        <field name="name">transport.assurance.bus.form</field>
        <field name="model">transport.assurance.bus</field>
        <field name="arch" type="xml">
            <form string="Police assurance bus">
                <header>
                    <button name="action_activer" string="Activer" type="object"
                            class="oe_highlight"
                            invisible="state != 'brouillon'"/>
                    <button name="action_renouveler" string="Renouveler" type="object"
                            class="oe_highlight"
                            invisible="state not in ('active','alerte','expirée')"/>
                    <button name="action_resilier" string="Résilier" type="object"
                            invisible="state not in ('active','alerte')"/>
                    <button name="action_voir_sinistres" string="Voir sinistres" type="object"
                            invisible="nb_sinistres == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,active,alerte,expirée"/>
                </header>
                <div class="alert alert-danger" role="alert"
                     invisible="not is_obligatoire or state not in ('expirée','résiliée')">
                    <p><strong translate="True">Police obligatoire expirée</strong> — <span translate="True">Ce bus ne peut plus être affecté à des tournées (règle Tunisie).</span></p>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="visite_technique_valide or not type_police_id">
                    <p><strong translate="True">Visite technique</strong> — <span translate="True">Absente ou expirée. Le renouvellement RC sera bloqué.</span></p>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="numero_police" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Identification police">
                            <field name="vehicle_id" required="1"/>
                            <field name="type_police_id" required="1"/>
                            <field name="compagnie_id" required="1"/>
                            <field name="is_obligatoire" readonly="1"/>
                        </group>
                        <group string="Validité">
                            <field name="date_debut" required="1"/>
                            <field name="date_fin" required="1"/>
                            <field name="date_alerte" readonly="1"/>
                            <field name="date_visite_technique"/>
                            <field name="visite_technique_valide" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Conditions financières">
                            <field name="prime_annuelle"/>
                            <field name="prime_mensuelle" readonly="1"/>
                            <field name="franchise"/>
                            <field name="plafond_garantie"/>
                        </group>
                        <group string="Sinistralité">
                            <field name="nb_sinistres" readonly="1"/>
                            <field name="montant_total_indemnise" readonly="1"/>
                            <field name="police_precedente_id" readonly="1"/>
                            <field name="police_suivante_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sinistres liés" name="sinistres" invisible="nb_sinistres == 0">
                            <field name="sinistre_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_sinistre"/>
                                    <field name="nature_sinistre"/>
                                    <field name="lieu"/>
                                    <field name="montant_reclame"/>
                                    <field name="montant_accorde"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'cloture'"
                                           decoration-danger="state == 'rejete'"
                                           decoration-warning="state in ('declare','instruction')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_assurance_bus_list" model="ir.ui.view">
        <field name="name">transport.assurance.bus.list</field>
        <field name="model">transport.assurance.bus</field>
        <field name="arch" type="xml">
            <list string="Polices assurance bus"
                  decoration-danger="state in ('expirée','résiliée')"
                  decoration-warning="state == 'alerte'"
                  decoration-success="state == 'active'">
                <field name="numero_police"/>
                <field name="vehicle_id"/>
                <field name="type_police_id"/>
                <field name="compagnie_id"/>
                <field name="date_debut"/>
                <field name="date_fin" string="Expiration"/>
                <field name="prime_annuelle"/>
                <field name="franchise"/>
                <field name="is_obligatoire" widget="boolean"/>
                <field name="visite_technique_valide" widget="boolean"/>
                <field name="nb_sinistres"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'alerte'"
                       decoration-danger="state in ('expirée','résiliée')"
                       decoration-muted="state == 'brouillon'"/>
            </list>
        </field>
    </record>

    <record id="view_assurance_bus_search" model="ir.ui.view">
        <field name="name">transport.assurance.bus.search</field>
        <field name="model">transport.assurance.bus</field>
        <field name="arch" type="xml">
            <search string="Recherche polices bus">
                <field name="vehicle_id"/>
                <field name="compagnie_id"/>
                <field name="type_police_id"/>
                <field name="numero_police"/>
                <filter string="Actives" name="actives" domain="[('state','=','active')]"/>
                <filter string="En alerte" name="alerte" domain="[('state','=','alerte')]"/>
                <filter string="Expirées" name="expirees" domain="[('state','=','expirée')]"/>
                <filter string="Obligatoires" name="obligatoires" domain="[('is_obligatoire','=',True)]"/>
                <separator/>
                <filter string="RC" name="rc" domain="[('type_police_id.code','=','RC')]"/>
                <filter string="Voyage" name="voyage" domain="[('type_police_id.code','=','VOYAGE')]"/>
                <separator/>
                <filter string="Par état" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Par compagnie" name="group_compagnie" context="{'group_by': 'compagnie_id'}"/>
                <filter string="Par type" name="group_type" context="{'group_by': 'type_police_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_assurance_bus" model="ir.actions.act_window">
        <field name="name">Polices assurance bus</field>
        <field name="res_model">transport.assurance.bus</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assurance_bus_search"/>
    </record>

</odoo>