<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron 1 : Mise à jour états polices (quotidien) -->
        <record id="cron_assurance_update_states" model="ir.cron">
            <field name="name">Assurance — Mise à jour états polices</field>
            <field name="model_id" ref="model_transport_assurance_cron"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_states()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="priority">6</field>
        </record>

        <!-- Cron 2 : Alertes d'échéance (quotidien) -->
        <record id="cron_assurance_alertes" model="ir.cron">
            <field name="name">Assurance — Alertes échéances polices</field>
            <field name="model_id" ref="model_transport_assurance_cron"/>
            <field name="state">code</field>
            <field name="code">model.cron_alertes_echeance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- Cron 3 : Bus non assurés — alerte légale (quotidien) -->
        <record id="cron_assurance_bus_non_assures" model="ir.cron">
            <field name="name">Assurance — Vérification bus non assurés</field>
            <field name="model_id" ref="model_transport_assurance_cron"/>
            <field name="state">code</field>
            <field name="code">model.cron_bus_non_assures()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="priority">4</field>
        </record>

    </data>
</odoo>