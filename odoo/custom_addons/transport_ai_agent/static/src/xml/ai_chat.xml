<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="transport_ai_agent.ChatInterface" owl="1">
<div class="ai_chat_wrapper">

  <!-- ══ SIDEBAR ══════════════════════════════════════════════════════════ -->
  <div class="ai_sidebar">

    <div class="ai_sidebar_logo">
      <div class="ai_sidebar_logo_icon">⚡</div>
      <div>
        <div class="ai_sidebar_logo_text">Agent IA</div>
        <div class="ai_sidebar_logo_sub">ERP Transport</div>
      </div>
    </div>

    <!-- Sélecteur de mode -->
    <div class="ai_mode_tabs">
      <button t-attf-class="ai_mode_tab {{ state.mode === 'chat' ? 'active' : '' }}"
              t-on-click="() => this.setMode('chat')">
        💬 Chat
      </button>
      <button t-attf-class="ai_mode_tab {{ state.mode === 'rapport' ? 'active' : '' }}"
              t-on-click="() => this.setMode('rapport')">
        📊 Rapports
      </button>
    </div>

    <!-- Sidebar Chat : nouvelle conv + historique -->
    <t t-if="state.mode === 'chat'">
      <button class="ai_new_chat_btn" t-on-click="newConversation">
        ✏️ Nouvelle conversation
      </button>
      <div class="ai_sidebar_section">Conversations récentes</div>
      <div class="ai_history_list">
        <t t-foreach="state.history" t-as="conv" t-key="conv.id">
          <div t-attf-class="ai_history_item {{ conv.id === state.currentId ? 'active' : '' }}"
               t-on-click="() => this.loadConversation(conv.id)">
            <div class="ai_history_item_content">
              <span class="ai_history_name"><t t-esc="conv.name"/></span>
              <span class="ai_history_date"><t t-esc="conv.date"/></span>
            </div>
          </div>
        </t>
      </div>
    </t>

    <!-- Sidebar Rapport : liste des rapports disponibles -->
    <t t-if="state.mode === 'rapport'">
      <div class="ai_sidebar_section">Choisir un rapport</div>
      <div class="ai_rapport_list">
        <t t-foreach="RAPPORTS" t-as="rpt" t-key="rpt.id">
          <div t-attf-class="ai_rapport_item {{ state.rapportSelectionne === rpt.id ? 'active' : '' }}"
               t-on-click="() => this.selectRapport(rpt.id)">
            <div class="ai_rapport_item_label"><t t-esc="rpt.label"/></div>
            <div class="ai_rapport_item_desc"><t t-esc="rpt.description"/></div>
          </div>
        </t>
      </div>
    </t>

    <!-- Footer utilisateur -->
    <div class="ai_sidebar_user">
      <div class="ai_user_avatar"><t t-esc="state.userInitials"/></div>
      <div class="ai_user_info">
        <span class="ai_user_name"><t t-esc="state.userName"/></span>
        <span class="ai_user_role">Utilisateur ERP</span>
      </div>
    </div>

  </div>
  <!-- ════════════════════════════════════════════════════════════════════ -->

  <!-- ══ ZONE PRINCIPALE ══════════════════════════════════════════════════ -->
  <div class="ai_main">

    <!-- ── MODE CHAT ─────────────────────────────────────────────────────── -->
    <t t-if="state.mode === 'chat'">

      <div class="ai_messages_area" id="ai_messages_list">
        <div class="ai_messages_inner">

          <!-- Écran d'accueil -->
          <t t-if="state.messages.length === 0">
            <div class="ai_welcome">
              <div class="ai_welcome_icon">⚡</div>
              <p class="ai_welcome_title">Comment puis-je vous aider ?</p>
              <p class="ai_welcome_sub">
                Posez vos questions sur les tournées, le carburant,
                les assurances, le patrimoine ou le courrier BOC.
              </p>
              <div class="ai_suggestions">
                <button class="ai_suggestion_btn"
                  t-on-click="() => this.askSuggestion('Combien de tournées sont planifiées aujourd\'hui ?')">
                  <span class="ai_suggestion_icon">🚌</span>
                  Tournées planifiées aujourd'hui
                </button>
                <button class="ai_suggestion_btn"
                  t-on-click="() => this.askSuggestion('Quel est le stock actuel des cuves carburant ?')">
                  <span class="ai_suggestion_icon">⛽</span>
                  Stock des cuves carburant
                </button>
                <button class="ai_suggestion_btn"
                  t-on-click="() => this.askSuggestion('Quelles assurances expirent dans les 30 prochains jours ?')">
                  <span class="ai_suggestion_icon">🛡️</span>
                  Assurances expirant bientôt
                </button>
                <button class="ai_suggestion_btn"
                  t-on-click="() => this.askSuggestion('Donne-moi l\'état de tous les bus du parc')">
                  <span class="ai_suggestion_icon">📊</span>
                  État du parc bus
                </button>
                <button class="ai_suggestion_btn"
                  t-on-click="() => this.askSuggestion('Quelles sont les tournées réalisées ce mois ?')">
                  <span class="ai_suggestion_icon">📋</span>
                  Tournées du mois
                </button>
                <button class="ai_suggestion_btn"
                  t-on-click="() => this.askSuggestion('Montre-moi les courriers en retard')">
                  <span class="ai_suggestion_icon">📬</span>
                  Courriers en retard
                </button>
              </div>
            </div>
          </t>

          <!-- Messages -->
          <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
            <div t-attf-class="ai_message_row ai_message_row_{{ msg.type }}">
              <div t-attf-class="ai_message_avatar ai_avatar_{{ msg.type }}">
                <t t-if="msg.type === 'agent'">⚡</t>
                <t t-else=""><t t-esc="state.userInitials"/></t>
              </div>
              <div class="ai_message_content">
                <div t-attf-class="ai_bubble ai_bubble_{{ msg.type }}">
                  <t t-if="msg.content">
                    <t t-esc="msg.content"/>
                  </t>
                  <t t-else="">
                    <span style="color:#9ca3af;font-style:italic;">...</span>
                  </t>
                </div>
                <t t-if="msg.type === 'agent' and msg.pdf_url">
                  <div class="ai_pdf_actions">
                    <button class="ai_pdf_btn_open"
                            t-on-click="() => this.ouvrirPDF(msg.pdf_url)">
                      🔍 Ouvrir le PDF
                    </button>
                    <button class="ai_pdf_btn_dl"
                            t-on-click="() => this.telechargerPDF(msg.pdf_url, this._getNomFichier(msg.pdf_url))">
                      ⬇ Télécharger
                    </button>
                  </div>
                </t>
                <span class="ai_message_time"><t t-esc="msg.time"/></span>
              </div>
            </div>
          </t>

          <!-- Indicateur chargement -->
          <t t-if="state.loading">
            <div class="ai_typing_row">
              <div class="ai_message_avatar ai_avatar_agent">⚡</div>
              <div class="ai_typing_bubble">
                <span/><span/><span/>
              </div>
            </div>
          </t>

        </div>
      </div>

      <!-- Zone saisie -->
      <div class="ai_input_area">
        <div class="ai_input_inner">
          <div class="ai_input_box">
            <textarea
              class="ai_textarea"
              placeholder="Posez votre question en français..."
              t-att-value="state.question"
              t-on-input="onInput"
              t-on-keydown="onKeyDown"
              t-att-disabled="state.loading"
              rows="1"
            />
            <button
              class="ai_send_button"
              t-on-click="sendQuestion"
              t-att-disabled="state.loading or !state.question.trim()">
              <t t-if="state.loading">…</t>
              <t t-else="">➤</t>
            </button>
          </div>
          <p class="ai_input_hint">
            Entrée pour envoyer · Shift+Entrée pour nouvelle ligne
          </p>
        </div>
      </div>

    </t>
    <!-- ── FIN MODE CHAT ──────────────────────────────────────────────────── -->

    <!-- ── MODE RAPPORT ──────────────────────────────────────────────────── -->
    <t t-if="state.mode === 'rapport'">

      <div class="ai_rapport_main">

        <!-- En-tête -->
        <div class="ai_rapport_header">
          <div class="ai_rapport_header_icon">📊</div>
          <div>
            <h2 class="ai_rapport_header_title">Génération de rapports PDF</h2>
            <p class="ai_rapport_header_sub">
              Décrivez le rapport souhaité ou choisissez dans la liste.
            </p>
          </div>
        </div>

        <!-- Zone saisie libre -->
        <div class="ai_rapport_input_zone">
          <div class="ai_rapport_input_box">
            <span class="ai_rapport_input_icon">🔍</span>
            <input
              type="text"
              class="ai_rapport_input"
              placeholder="Ex: rapport assurance, bilan carburant, état du parc..."
              t-att-value="state.rapportTexte"
              t-on-input="onRapportTexteInput"
              t-on-keydown="onRapportTexteKeyDown"
              t-att-disabled="state.rapportLoading"
            />
            <t t-if="state.rapportTexte">
              <button class="ai_rapport_input_clear"
                      t-on-click="() => { state.rapportTexte=''; state.rapportDetecte=null; state.rapportDetectionMsg=''; }">
                ✕
              </button>
            </t>
            <button class="ai_rapport_input_send"
                    t-on-click="envoyerTexteRapport"
                    t-att-disabled="state.rapportLoading or !state.rapportTexte.trim()">
              <t t-if="state.rapportLoading">…</t>
              <t t-else="">➤</t>
            </button>
          </div>
          <t t-if="state.rapportDetectionMsg">
            <div t-attf-class="ai_rapport_detection_msg {{ state.rapportDetectionMsg.startsWith('⏳') ? 'info' : 'warn' }}">
              <t t-esc="state.rapportDetectionMsg"/>
            </div>
          </t>
        </div>

        <!-- Aucun rapport sélectionné et pas de résultat -->
        <t t-if="!state.rapportSelectionne and !state.rapportResultat and !state.rapportErreur">
          <div class="ai_rapport_placeholder">
            <div class="ai_rapport_placeholder_icon">👈</div>
            <p>Saisissez votre demande ou choisissez un rapport dans le menu de gauche</p>
          </div>
        </t>

        <!-- Rapport sélectionné dans la liste → afficher la carte -->
        <t t-if="state.rapportSelectionne">
          <div class="ai_rapport_card">
            <t t-foreach="RAPPORTS" t-as="rpt" t-key="rpt.id">
              <t t-if="rpt.id === state.rapportSelectionne">
                <div class="ai_rapport_card_top">
                  <div class="ai_rapport_card_label"><t t-esc="rpt.label"/></div>
                  <div class="ai_rapport_card_badge"><t t-esc="rpt.categorie"/></div>
                </div>
                <div class="ai_rapport_card_desc"><t t-esc="rpt.description"/></div>
              </t>
            </t>
            <button
              class="ai_rapport_generate_btn"
              t-on-click="genererRapport"
              t-att-disabled="state.rapportLoading or !state.rapportSelectionne">
              <t t-if="state.rapportLoading">
                <span class="ai_rapport_spinner"/>
                Génération en cours...
              </t>
              <t t-else="">
                ⚡ Générer le rapport PDF
              </t>
            </button>
          </div>
        </t>

        <!-- Résultat — affiché quel que soit le mode (liste ou texte libre) -->
        <t t-if="state.rapportResultat">
          <div class="ai_rapport_result">
            <div class="ai_rapport_result_icon">✅</div>
            <div class="ai_rapport_result_content">
              <div class="ai_rapport_result_title">
                Rapport prêt : <t t-esc="state.rapportResultat.label"/>
              </div>
              <div class="ai_rapport_result_date">
                Généré le
                <t t-esc="new Date().toLocaleDateString('fr-FR', {day:'2-digit',month:'long',year:'numeric'})"/>
                à
                <t t-esc="new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'})"/>
              </div>
              <div class="ai_rapport_result_actions">
                <button class="ai_pdf_btn_open ai_rapport_btn"
                        t-on-click="ouvrirRapportPDF">
                  🔍 Ouvrir le PDF
                </button>
                <button class="ai_pdf_btn_dl ai_rapport_btn"
                        t-on-click="telechargerRapportPDF">
                  ⬇ Télécharger
                </button>
              </div>
            </div>
          </div>
        </t>

        <!-- Erreur -->
        <t t-if="state.rapportErreur">
          <div class="ai_rapport_error">
            ❌ <t t-esc="state.rapportErreur"/>
          </div>
        </t>

        <!-- Grille des rapports disponibles (aperçu rapide) -->
        <div class="ai_rapport_grid_title">Tous les rapports disponibles</div>
        <div class="ai_rapport_grid">
          <t t-foreach="RAPPORTS" t-as="rpt" t-key="rpt.id">
            <div t-attf-class="ai_rapport_grid_item {{ state.rapportSelectionne === rpt.id ? 'selected' : '' }}"
                 t-on-click="() => this.selectRapport(rpt.id)">
              <div class="ai_rapport_grid_label"><t t-esc="rpt.label"/></div>
              <div class="ai_rapport_grid_desc"><t t-esc="rpt.description"/></div>
              <div class="ai_rapport_grid_badge"><t t-esc="rpt.categorie"/></div>
            </div>
          </t>
        </div>

      </div>

    </t>
    <!-- ── FIN MODE RAPPORT ───────────────────────────────────────────────── -->

  </div>
  <!-- ════════════════════════════════════════════════════════════════════ -->

</div>
</t>

</templates>