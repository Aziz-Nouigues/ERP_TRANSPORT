<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_generer_tableaux_amortissement" model="ir.cron">
            <field name="name">Patrimoine — Générer les tableaux d'amortissement</field>
            <field name="model_id" ref="model_patrimoine_immobilisation"/>
            <field name="state">code</field>
            <field name="code">model._cron_generer_tableaux_amortissement()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_alerte_amortis" model="ir.cron">
            <field name="name">Patrimoine — Alerte immobilisations entièrement amorties</field>
            <field name="model_id" ref="model_patrimoine_immobilisation"/>
            <field name="state">code</field>
            <field name="code">model._cron_alerte_entierement_amortis()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_alerte_inventaire" model="ir.cron">
            <field name="name">Patrimoine — Rappel inventaire annuel obligatoire</field>
            <field name="model_id" ref="model_patrimoine_inventaire"/>
            <field name="state">code</field>
            <field name="code">model._cron_rappel_inventaire_annuel()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- CDC : comptabilisation automatique selon périodicité des dates d'arrêtés -->
        <record id="cron_comptabiliser_dotations_periode" model="ir.cron">
            <field name="name">Patrimoine — Comptabiliser automatiquement les dotations aux amortissements</field>
            <field name="model_id" ref="model_patrimoine_immobilisation"/>
            <field name="state">code</field>
            <field name="code">model._cron_comptabiliser_dotations_periode()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>