<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégories standard patrimoine transport -->
    <record id="cat_terrains" model="patrimoine.categorie">
        <field name="name">Terrains</field>
        <field name="code">10</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">0</field>
    </record>

    <record id="cat_constructions" model="patrimoine.categorie">
        <field name="name">Constructions</field>
        <field name="code">21</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">20</field>
    </record>

    <record id="cat_materiel_transport" model="patrimoine.categorie">
        <field name="name">Matériel de transport</field>
        <field name="code">24</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">5</field>
    </record>

    <record id="cat_materiel_bureau" model="patrimoine.categorie">
        <field name="name">Mobilier et matériel de bureau</field>
        <field name="code">25</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">5</field>
    </record>

    <record id="cat_materiel_informatique" model="patrimoine.categorie">
        <field name="name">Matériel informatique</field>
        <field name="code">26</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">3</field>
    </record>

    <record id="cat_installations" model="patrimoine.categorie">
        <field name="name">Installations et agencements</field>
        <field name="code">23</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">10</field>
    </record>

    <record id="cat_materiel_roulant" model="patrimoine.categorie">
        <field name="name">Matériel roulant (bus / autocars)</field>
        <field name="code">241</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">7</field>
    </record>

    <record id="cat_logiciels" model="patrimoine.categorie">
        <field name="name">Logiciels et licences</field>
        <field name="code">27</field>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">3</field>
    </record>

    <!-- Sous-catégories matériel roulant -->
    <record id="sous_cat_autobus_urbain" model="patrimoine.sous.categorie">
        <field name="name">Autobus urbains</field>
        <field name="code">241-01</field>
        <field name="categorie_id" ref="cat_materiel_roulant"/>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">7</field>
    </record>

    <record id="sous_cat_autobus_regional" model="patrimoine.sous.categorie">
        <field name="name">Autocars régionaux</field>
        <field name="code">241-02</field>
        <field name="categorie_id" ref="cat_materiel_roulant"/>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">10</field>
    </record>

    <record id="sous_cat_voitures_service" model="patrimoine.sous.categorie">
        <field name="name">Voitures de service</field>
        <field name="code">241-03</field>
        <field name="categorie_id" ref="cat_materiel_roulant"/>
        <field name="methode_amortissement">lineaire</field>
        <field name="duree_amortissement">5</field>
    </record>

    <!-- Sous-catégories matériel informatique -->
    <record id="sous_cat_serveurs" model="patrimoine.sous.categorie">
        <field name="name">Serveurs et équipements réseau</field>
        <field name="code">26-01</field>
        <field name="categorie_id" ref="cat_materiel_informatique"/>
        <field name="duree_amortissement">5</field>
    </record>

    <record id="sous_cat_postes_travail" model="patrimoine.sous.categorie">
        <field name="name">Postes de travail (PC / tablettes)</field>
        <field name="code">26-02</field>
        <field name="categorie_id" ref="cat_materiel_informatique"/>
        <field name="duree_amortissement">3</field>
    </record>
</odoo>
