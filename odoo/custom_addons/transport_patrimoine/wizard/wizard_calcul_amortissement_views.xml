<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_calcul_amortissement_form" model="ir.ui.view">
        <field name="name">patrimoine.wizard.calcul.amortissement.form</field>
        <field name="model">patrimoine.wizard.calcul.amortissement</field>
        <field name="arch" type="xml">
            <form string="Calcul des dotations aux amortissements">
                <group string="Paramètres">
                    <group>
                        <field name="annee"/>
                        <field name="date_arrete"/>
                        <field name="mode"/>
                    </group>
                    <group>
                        <field name="categorie_id"/>
                        <field name="methode_filtre"/>
                    </group>
                </group>
                <group string="Résultat simulation" invisible="not simulation_faite">
                    <field name="nb_lignes" readonly="1"/>
                    <field name="montant_total" readonly="1"/>
                </group>
                <footer>
                    <button name="action_simuler" string="Simuler"
                            type="object" class="btn-secondary"/>
                    <button name="action_valider" string="Comptabiliser les dotations"
                            type="object" class="btn-primary"
                            invisible="mode != 'validation'"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_calcul_amortissement" model="ir.actions.act_window">
        <field name="name">Calcul des amortissements</field>
        <field name="res_model">patrimoine.wizard.calcul.amortissement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
