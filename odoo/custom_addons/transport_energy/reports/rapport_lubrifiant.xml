<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         RAPPORT LUBRIFIANTS PAR VEHICULE
         كشف استهلاك العربة للسوائل
    ═══════════════════════════════════════════════════════ -->

    <template id="rapport_lubrifiant_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page" style="direction:rtl; font-family: Arial, sans-serif;">

                        <!-- TITRE -->
                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#6c3483; border-bottom:3px solid #6c3483; padding-bottom:8px;">
                                كشف استهلاك العربة للمزيتات
                            </h2>
                            <h4 style="color:#555;">Rapport Consommation Lubrifiants par Vehicule</h4>
                            <p>
                                <strong>من</strong> <t t-esc="wizard.date_debut"/>
                                <strong> الى </strong> <t t-esc="wizard.date_fin"/>
                                <t t-if="wizard.atelier_filtre">
                                    | <strong>الورشة:</strong> <t t-esc="wizard.atelier_filtre"/>
                                </t>
                            </p>
                        </div>

                        <t t-set="lignes" t-value="wizard._get_donnees_lubrifiant()"/>

                        <!-- RÉSUMÉ -->
                        <div style="background:#f4ecf7; padding:10px; border-radius:5px; margin-bottom:15px;">
                            <strong>ملخص: </strong>
                            عدد العربات: <strong><t t-esc="len(lignes)"/></strong>
                            | اجمالي الكمية:
                            <strong><t t-esc="round(sum(l['total_quantite'] for l in lignes), 2)"/> L</strong>
                            | عدد الفيدانجات:
                            <strong><t t-esc="sum(l['nb_vidanges'] for l in lignes)"/></strong>
                            | عدد الاضافات:
                            <strong><t t-esc="sum(l['nb_additions'] for l in lignes)"/></strong>
                        </div>

                        <!-- TABLEAU PRINCIPAL -->
                        <table class="table table-sm table-bordered" style="width:100%; font-size:11px; direction:rtl;">
                            <thead style="background:#6c3483; color:white;">
                                <tr>
                                    <th style="text-align:center;">العربة</th>
                                    <th style="text-align:center;">الصنف</th>
                                    <th style="text-align:center;">الورشة</th>
                                    <th style="text-align:center;">نوع المزيت</th>
                                    <th style="text-align:center;">عدد الفيدانجات</th>
                                    <th style="text-align:center;">كمية الفيدانج (L)</th>
                                    <th style="text-align:center;">عدد الاضافات</th>
                                    <th style="text-align:center;">كمية الاضافة (L)</th>
                                    <th style="text-align:center;">الكمية الاجمالية (L)</th>
                                    <th style="text-align:center;">عداد الكيلومتر</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lignes" t-as="ligne">
                                    <tr>
                                        <td style="font-weight:bold;"><t t-esc="ligne['bus_name']"/></td>
                                        <td><t t-esc="ligne['bus_type']"/></td>
                                        <td><t t-esc="ligne['atelier']"/></td>
                                        <td><t t-esc="ligne['type_lubrifiant']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['nb_vidanges']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['qte_vidange']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['nb_additions']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['qte_addition']"/></td>
                                        <td style="text-align:center; font-weight:bold;"><t t-esc="ligne['total_quantite']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['kilometrage']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot style="background:#d7bde2; font-weight:bold;">
                                <tr>
                                    <td colspan="4" style="text-align:right;">الجملة</td>
                                    <td style="text-align:center;"><t t-esc="sum(l['nb_vidanges'] for l in lignes)"/></td>
                                    <td style="text-align:center;"><t t-esc="round(sum(l['qte_vidange'] for l in lignes), 2)"/></td>
                                    <td style="text-align:center;"><t t-esc="sum(l['nb_additions'] for l in lignes)"/></td>
                                    <td style="text-align:center;"><t t-esc="round(sum(l['qte_addition'] for l in lignes), 2)"/></td>
                                    <td style="text-align:center;"><t t-esc="round(sum(l['total_quantite'] for l in lignes), 2)"/></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_lubrifiant" model="ir.actions.report">
        <field name="name">Rapport Lubrifiants par Vehicule</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_lubrifiant_template</field>
        <field name="report_file">transport_energy.rapport_lubrifiant_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>

</odoo>