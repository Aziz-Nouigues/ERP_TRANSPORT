<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         RAPPORT DISTRIBUTION PAR VEHICULE
         جدول توزيع السوائل حسب العربة
    ═══════════════════════════════════════════════════════ -->

    <template id="rapport_par_vehicule_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page" style="direction:rtl; font-family: Arial, sans-serif;">

                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                جدول توزيع المحروقات حسب العربة
                            </h2>
                            <h4 style="color:#555;">Distribution de Carburant par Vehicule</h4>
                            <p>
                                <strong>من</strong> <t t-esc="wizard.date_debut"/>
                                <strong> الى </strong> <t t-esc="wizard.date_fin"/>
                                <t t-if="wizard.station_id">
                                    | <strong>المحطة:</strong> <t t-esc="wizard.station_id.name"/>
                                </t>
                            </p>
                        </div>

                        <t t-set="lignes" t-value="wizard._get_donnees_par_vehicule()"/>

                        <p style="color:red; font-size:14px;">
                            DEBUG: <t t-esc="len(lignes)"/> vehicules trouves
                        </p>

                        <div style="background:#eaf2ff; padding:10px; border-radius:5px; margin-bottom:15px;">
                            <strong>ملخص: </strong>
                            عدد العربات: <strong><t t-esc="len(lignes)"/></strong>
                            | اجمالي الكمية:
                            <strong><t t-esc="sum(l['total_litres'] for l in lignes)"/> L</strong>
                        </div>

                        <table class="table table-sm table-bordered" style="width:100%; font-size:11px; direction:rtl;">
                            <thead style="background:#1a5276; color:white;">
                                <tr>
                                    <th>العربة</th>
                                    <th>الصنف</th>
                                    <th>المصلحة</th>
                                    <th>عدد الخروجات</th>
                                    <th>الكمية (L)</th>
                                    <th>المسافة (km)</th>
                                    <th>الاستهلاك الفعلي</th>
                                    <th>الاستهلاك النظري</th>
                                    <th>الفارق</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lignes" t-as="ligne">
                                    <tr>
                                        <td><t t-esc="ligne['bus_name']"/></td>
                                        <td><t t-esc="ligne['bus_type']"/></td>
                                        <td><t t-esc="ligne['service_code']"/></td>
                                        <td><t t-esc="ligne['nb_sorties']"/></td>
                                        <td><t t-esc="ligne['total_litres']"/></td>
                                        <td><t t-esc="ligne['total_km']"/></td>
                                        <td><t t-esc="ligne['conso_reelle']"/></td>
                                        <td><t t-esc="ligne['conso_theorique']"/></td>
                                        <td><t t-esc="ligne['ecart']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot style="background:#d5e8d4; font-weight:bold;">
                                <tr>
                                    <td colspan="4">الجملة</td>
                                    <td><t t-esc="round(sum(l['total_litres'] for l in lignes), 2)"/></td>
                                    <td colspan="4"></td>
                                </tr>
                            </tfoot>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_par_vehicule" model="ir.actions.report">
        <field name="name">Distribution Carburant par Vehicule</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_par_vehicule_template</field>
        <field name="report_file">transport_energy.rapport_par_vehicule_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>


    <!-- ═══════════════════════════════════════════════════════
         RAPPORT DISTRIBUTION PAR STATION
         جدول توزيع السوائل حسب المغازة
    ═══════════════════════════════════════════════════════ -->

    <template id="rapport_par_station_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page" style="direction:rtl; font-family: Arial, sans-serif;">

                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                جدول توزيع المحروقات حسب المغازة
                            </h2>
                            <h4 style="color:#555;">Distribution de Carburant par Station</h4>
                            <p>
                                <strong>من</strong> <t t-esc="wizard.date_debut"/>
                                <strong> الى </strong> <t t-esc="wizard.date_fin"/>
                            </p>
                        </div>

                        <t t-set="stations" t-value="wizard._get_donnees_par_station()"/>

                        <p style="color:red; font-size:14px;">
                            DEBUG: <t t-esc="len(stations)"/> stations trouvees
                        </p>

                        <t t-foreach="stations" t-as="station">
                            <div style="background:#1a5276; color:white; padding:8px; border-radius:5px; margin-top:15px;">
                                <strong>
                                    محطة: <t t-esc="station['station_name']"/>
                                    | الوقود: <t t-esc="station['fuel_type']"/>
                                </strong>
                            </div>
                            <div style="background:#eaf2ff; padding:8px; margin-bottom:8px; font-size:12px;">
                                عدد البوانات: <strong><t t-esc="station['nb_bons']"/></strong>
                                | عدد العربات: <strong><t t-esc="station['nb_vehicules']"/></strong>
                                | اجمالي الكمية: <strong><t t-esc="station['total_litres']"/> L</strong>
                                | المخزون المتبقي: <strong><t t-esc="station['stock_restant']"/> L</strong>
                            </div>
                            <table class="table table-sm table-bordered" style="width:100%; font-size:10px; direction:rtl; margin-bottom:15px;">
                                <thead style="background:#2e86c1; color:white;">
                                    <tr>
                                        <th>التاريخ</th>
                                        <th>رقم البون</th>
                                        <th>النوع</th>
                                        <th>العون الموزع</th>
                                        <th>عدد العربات</th>
                                        <th>الكمية (L)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="station['bons']" t-as="bon">
                                        <tr>
                                            <td><t t-esc="bon['date']"/></td>
                                            <td><t t-esc="bon['bon_name']"/></td>
                                            <td><t t-esc="bon['type']"/></td>
                                            <td><t t-esc="bon['agent']"/></td>
                                            <td><t t-esc="bon['nb_lignes']"/></td>
                                            <td><t t-esc="bon['quantite']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background:#d5e8d4; font-weight:bold;">
                                    <tr>
                                        <td colspan="5">الجملة</td>
                                        <td><t t-esc="station['total_litres']"/> L</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_par_station" model="ir.actions.report">
        <field name="name">Distribution Carburant par Station</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_par_station_template</field>
        <field name="report_file">transport_energy.rapport_par_station_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>

</odoo>