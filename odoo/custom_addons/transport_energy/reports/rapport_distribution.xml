<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ RAPPORT DISTRIBUTION PAR VEHICULE ═══ -->
    <template id="rapport_par_vehicule_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">

                <!-- ═══ LANGUE AUTOMATIQUE ═══ -->
                <t t-set="lang" t-value="wizard.env.user.lang or 'fr_FR'"/>
                <t t-set="wizard" t-value="wizard.with_context(lang=lang)"/>
                <t t-set="lbl" t-value="wizard._get_labels()"/>
                <t t-set="is_rtl" t-value="lang.startswith('ar')"/>

                <t t-call="web.external_layout">
                    <div class="page" t-att-style="'direction:rtl;' if is_rtl else 'direction:ltr;'" style="font-family: Arial, sans-serif;">

                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                <t t-esc="lbl['titre_par_vehicule']"/>
                            </h2>
                            <p>
                                <t t-esc="lbl['de']"/> <t t-esc="wizard.date_debut"/>
                                <t t-esc="lbl['au']"/> <t t-esc="wizard.date_fin"/>
                                <t t-if="wizard.station_id">
                                    | <t t-esc="lbl['station']"/> : <t t-esc="wizard.station_id.name"/>
                                </t>
                            </p>
                        </div>

                        <t t-set="lignes" t-value="wizard._get_donnees_par_vehicule()"/>

                        <div style="background:#eaf2ff; padding:10px; border-radius:5px; margin-bottom:15px;">
                            <strong><t t-esc="lbl['nb_vehicules']"/> : </strong>
                            <strong><t t-esc="len(lignes)"/></strong>
                            | <t t-esc="lbl['quantite_consommee']"/> :
                            <strong><t t-esc="sum(l['total_litres'] for l in lignes)"/> L</strong>
                        </div>

                        <table class="table table-sm table-bordered" style="width:100%; font-size:11px;">
                            <thead style="background:#1a5276; color:white;">
                                <tr>
                                    <th><t t-esc="lbl['bus']"/></th>
                                    <th><t t-esc="lbl['type']"/></th>
                                    <th><t t-esc="lbl['service']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['nb_sorties']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['quantite']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['distance']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['reelle']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['theorique']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['ecart']"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lignes" t-as="ligne">
                                    <tr>
                                        <td><t t-esc="ligne['bus_name']"/></td>
                                        <td><t t-esc="ligne['bus_type']"/></td>
                                        <td><t t-esc="ligne['service_code']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['nb_sorties']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['total_litres']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['total_km']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['conso_reelle']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['conso_theorique']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['ecart']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot style="background:#d5e8d4; font-weight:bold;">
                                <tr>
                                    <td colspan="4"><t t-esc="lbl['total']"/></td>
                                    <td style="text-align:center;"><t t-esc="round(sum(l['total_litres'] for l in lignes), 2)"/></td>
                                    <td colspan="4"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- SIGNATURE -->
                        <table style="width:100%; margin-top:40px;">
                            <tr>
                                <td style="width:50%; text-align:center;">
                                    <strong><t t-esc="lbl['responsable_energie']"/></strong>
                                    <br/><br/><br/>___________________
                                </td>
                                <td style="width:50%; text-align:center;">
                                    <strong><t t-esc="lbl['directeur_technique']"/></strong>
                                    <br/><br/><br/>___________________
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_par_vehicule" model="ir.actions.report">
        <field name="name">Distribution Carburant par Vehicule</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_par_vehicule_template</field>
        <field name="report_file">transport_energy.rapport_par_vehicule_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>

    <!-- ═══ RAPPORT DISTRIBUTION PAR STATION ═══ -->
    <template id="rapport_par_station_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">

                <!-- ═══ LANGUE AUTOMATIQUE ═══ -->
                <t t-set="lang" t-value="wizard.env.user.lang or 'fr_FR'"/>
                <t t-set="wizard" t-value="wizard.with_context(lang=lang)"/>
                <t t-set="lbl" t-value="wizard._get_labels()"/>
                <t t-set="is_rtl" t-value="lang.startswith('ar')"/>

                <t t-call="web.external_layout">
                    <div class="page" t-att-style="'direction:rtl;' if is_rtl else 'direction:ltr;'" style="font-family: Arial, sans-serif;">

                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                <t t-esc="lbl['titre_par_station']"/>
                            </h2>
                            <p>
                                <t t-esc="lbl['de']"/> <t t-esc="wizard.date_debut"/>
                                <t t-esc="lbl['au']"/> <t t-esc="wizard.date_fin"/>
                            </p>
                        </div>

                        <t t-set="stations" t-value="wizard._get_donnees_par_station()"/>

                        <t t-foreach="stations" t-as="station">
                            <div style="background:#1a5276; color:white; padding:8px; border-radius:5px; margin-top:15px;">
                                <strong>
                                    <t t-esc="lbl['station_col']"/> : <t t-esc="station['station_name']"/>
                                    | <t t-esc="lbl['type']"/> : <t t-esc="station['fuel_type']"/>
                                </strong>
                            </div>
                            <div style="background:#eaf2ff; padding:8px; margin-bottom:8px; font-size:12px;">
                                <t t-esc="lbl['nb_bons']"/> : <strong><t t-esc="station['nb_bons']"/></strong>
                                | <t t-esc="lbl['nb_vehicules']"/> : <strong><t t-esc="station['nb_vehicules']"/></strong>
                                | <t t-esc="lbl['quantite_consommee']"/> : <strong><t t-esc="station['total_litres']"/> L</strong>
                                | <t t-esc="lbl['stock_restant']"/> : <strong><t t-esc="station['stock_restant']"/> L</strong>
                            </div>
                            <table class="table table-sm table-bordered" style="width:100%; font-size:10px; margin-bottom:15px;">
                                <thead style="background:#2e86c1; color:white;">
                                    <tr>
                                        <th><t t-esc="lbl['date']"/></th>
                                        <th><t t-esc="lbl['bon_no']"/></th>
                                        <th><t t-esc="lbl['type']"/></th>
                                        <th><t t-esc="lbl['agent']"/></th>
                                        <th style="text-align:center;"><t t-esc="lbl['nb_lignes']"/></th>
                                        <th style="text-align:center;"><t t-esc="lbl['quantite']"/></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="station['bons']" t-as="bon">
                                        <tr>
                                            <td><t t-esc="bon['date']"/></td>
                                            <td><t t-esc="bon['bon_name']"/></td>
                                            <td><t t-esc="bon['type']"/></td>
                                            <td><t t-esc="bon['agent']"/></td>
                                            <td style="text-align:center;"><t t-esc="bon['nb_lignes']"/></td>
                                            <td style="text-align:center;"><t t-esc="bon['quantite']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background:#d5e8d4; font-weight:bold;">
                                    <tr>
                                        <td colspan="5"><t t-esc="lbl['total']"/></td>
                                        <td style="text-align:center;"><t t-esc="station['total_litres']"/> L</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_par_station" model="ir.actions.report">
        <field name="name">Distribution Carburant par Station</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_par_station_template</field>
        <field name="report_file">transport_energy.rapport_par_station_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>

</odoo>