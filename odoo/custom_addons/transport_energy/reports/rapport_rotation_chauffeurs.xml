<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="rapport_rotation_chauffeurs_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">

                <!-- ═══ LANGUE AUTOMATIQUE ═══ -->
                <t t-set="lang" t-value="wizard.env.user.lang or 'fr_FR'"/>
                <t t-set="wizard" t-value="wizard.with_context(lang=lang)"/>
                <t t-set="lbl" t-value="wizard._get_labels()"/>
                <t t-set="is_rtl" t-value="lang.startswith('ar')"/>

                <t t-call="web.external_layout">
                    <div class="page" t-att-style="'direction:rtl;' if is_rtl else 'direction:ltr;'" style="font-family: Arial, sans-serif;">

                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                <t t-esc="lbl['titre_rotation']"/>
                            </h2>
                            <p>
                                <t t-esc="lbl['de']"/> <t t-esc="wizard.date_debut"/>
                                <t t-esc="lbl['au']"/> <t t-esc="wizard.date_fin"/>
                                <t t-if="wizard.agence_filtre">
                                    | <t t-esc="lbl['agence']"/> : <t t-esc="wizard.agence_filtre"/>
                                </t>
                            </p>
                        </div>

                        <t t-set="donnees" t-value="wizard._get_donnees_rotation()"/>

                        <div style="background:#eaf2ff; padding:10px; border-radius:5px; margin-bottom:15px;">
                            <t t-esc="lbl['nb_vehicules']"/> : <strong><t t-esc="donnees['nb_bus']"/></strong>
                            | <t t-esc="lbl['nb_chauffeurs']"/> :
                            <strong><t t-esc="donnees['total_chauffeurs']"/></strong>
                        </div>

                        <table class="table table-sm table-bordered" style="width:100%; font-size:11px;">
                            <thead style="background:#1a5276; color:white;">
                                <tr>
                                    <th><t t-esc="lbl['bus']"/></th>
                                    <th><t t-esc="lbl['type']"/></th>
                                    <th><t t-esc="lbl['agence']"/></th>
                                    <th><t t-esc="lbl['service']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['nb_sorties']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['nb_chauffeurs']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['quantite_consommee']"/></th>
                                    <th><t t-esc="lbl['liste_chauffeurs']"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="donnees['lignes']" t-as="ligne">
                                    <tr t-attf-style="background: {{ '#fdecea' if ligne['nb_chauffeurs'] > 10 else '#fef9e7' if ligne['nb_chauffeurs'] > 5 else 'white' }}">
                                        <td style="font-weight:bold;"><t t-esc="ligne['bus_name']"/></td>
                                        <td><t t-esc="ligne['bus_type']"/></td>
                                        <td><t t-esc="ligne['agence']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['service_code']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['nb_sorties']"/></td>
                                        <td t-attf-style="text-align:center; font-weight:bold; color: {{ 'red' if ligne['nb_chauffeurs'] > 10 else 'orange' if ligne['nb_chauffeurs'] > 5 else 'green' }}">
                                            <t t-esc="ligne['nb_chauffeurs']"/>
                                        </td>
                                        <td style="text-align:center;"><t t-esc="ligne['total_litres']"/></td>
                                        <td style="font-size:9px;"><t t-esc="ligne['liste_chauffeurs']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- SIGNATURE -->
                        <table style="width:100%; margin-top:40px;">
                            <tr>
                                <td style="width:50%; text-align:center;">
                                    <strong><t t-esc="lbl['responsable_energie']"/></strong>
                                    <br/><br/><br/>___________________
                                </td>
                                <td style="width:50%; text-align:center;">
                                    <strong><t t-esc="lbl['directeur_technique']"/></strong>
                                    <br/><br/><br/>___________________
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_rotation_chauffeurs" model="ir.actions.report">
        <field name="name">Rapport Rotation Chauffeurs</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_rotation_chauffeurs_template</field>
        <field name="report_file">transport_energy.rapport_rotation_chauffeurs_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>

</odoo>