<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_rapport_bge_pdf" model="ir.actions.report">
        <field name="name">Bon de Gasoil Externe (BGE)</field>
        <field name="model">transport.fuel.voucher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.report_bge_template</field>
        <field name="report_file">transport_energy.report_bge_template</field>
        <field name="binding_model_id" ref="model_transport_fuel_voucher"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bge_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Bon de Gasoil Externe (BGE) — <t t-esc="doc.name"/></h2>
                        <div class="row mt16">
                            <div class="col-6">
                                <strong>Date :</strong> <t t-esc="doc.date"/><br/>
                                <strong>Station externe :</strong> <t t-esc="doc.station_externe or ''"/><br/>
                                <strong>Ville :</strong> <t t-esc="doc.station_externe_ville or ''"/><br/>
                                <strong>Mode paiement :</strong> <t t-esc="dict(doc._fields['payment_mode'].selection).get(doc.payment_mode, '')"/><br/>
                                <t t-if="doc.agilis_card_id">
                                    <strong>Carte AGILIS :</strong> <t t-esc="doc.agilis_card_id.name"/><br/>
                                </t>
                                <t t-if="doc.ticket_reference">
                                    <strong>N Ticket :</strong> <t t-esc="doc.ticket_reference"/><br/>
                                </t>
                            </div>
                            <div class="col-6">
                                <strong>Type carburant :</strong> <t t-esc="doc.fuel_type_id.name if doc.fuel_type_id else ''"/><br/>
                                <strong>Statut :</strong> <t t-esc="dict(doc._fields['state'].selection).get(doc.state, '')"/>
                            </div>
                        </div>
                        <table class="table table-sm mt16">
                            <thead>
                                <tr>
                                    <th>Heure</th>
                                    <th>Bus</th>
                                    <th>Chauffeur</th>
                                    <th>Compteur (km)</th>
                                    <th>Quantite (L)</th>
                                    <th>Prix unit.</th>
                                    <th>Montant (TND)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.time"/></td>
                                        <td><t t-esc="line.vehicle_id.name if line.vehicle_id else ''"/></td>
                                        <td><t t-esc="line.driver_name or ''"/></td>
                                        <td><t t-esc="line.odometer_value"/></td>
                                        <td><t t-esc="line.quantity"/></td>
                                        <td><t t-esc="line.unit_price"/></td>
                                        <td><t t-esc="line.subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"><strong>Total</strong></td>
                                    <td><strong><t t-esc="doc.total_quantity"/> L</strong></td>
                                    <td></td>
                                    <td><strong><t t-esc="doc.total_cost"/> TND</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt32">
                            <div class="col-6">
                                <p>Signature agent :</p>
                                <br/><br/>___________________________
                            </div>
                            <div class="col-6">
                                <p>Visa responsable :</p>
                                <br/><br/>___________________________
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
