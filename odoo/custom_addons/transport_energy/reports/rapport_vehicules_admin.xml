<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="rapport_vehicules_admin_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">

                <!-- ═══ LANGUE AUTOMATIQUE ═══ -->
                <t t-set="lang" t-value="wizard.env.user.lang or 'fr_FR'"/>
                <t t-set="wizard" t-value="wizard.with_context(lang=lang)"/>
                <t t-set="lbl" t-value="wizard._get_labels()"/>
                <t t-set="is_rtl" t-value="lang.startswith('ar')"/>

                <t t-call="web.external_layout">
                    <div class="page" t-att-style="'direction:rtl;' if is_rtl else 'direction:ltr;'" style="font-family: Arial, sans-serif;">

                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                <t t-esc="lbl['titre_admin']"/>
                            </h2>
                            <p>
                                <t t-esc="lbl['de']"/> <t t-esc="wizard.date_debut"/>
                                <t t-esc="lbl['au']"/> <t t-esc="wizard.date_fin"/>
                            </p>
                        </div>

                        <t t-set="donnees" t-value="wizard._get_donnees_vehicules_admin()"/>

                        <div style="background:#eaf2ff; padding:10px; border-radius:5px; margin-bottom:15px;">
                            <t t-esc="lbl['nb_vehicules']"/> : <strong><t t-esc="donnees['nb_vehicules']"/></strong>
                            | <t t-esc="lbl['quantite_consommee']"/> : <strong><t t-esc="donnees['total_litres']"/> L</strong>
                            | <t t-esc="lbl['distance']"/> : <strong><t t-esc="donnees['total_km']"/> km</strong>
                        </div>

                        <table class="table table-sm table-bordered" style="width:100%; font-size:11px;">
                            <thead style="background:#1a5276; color:white;">
                                <tr>
                                    <th><t t-esc="lbl['bus']"/></th>
                                    <th style="text-align:center;">N° immat.</th>
                                    <th><t t-esc="lbl['type']"/></th>
                                    <th><t t-esc="lbl['agence']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['nb_sorties']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['quantite_consommee']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['distance']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['reelle']"/></th>
                                    <th style="text-align:center;"><t t-esc="lbl['theorique']"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="donnees['lignes']" t-as="ligne">
                                    <tr>
                                        <td style="font-weight:bold;"><t t-esc="ligne['nom']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['immatriculation']"/></td>
                                        <td><t t-esc="ligne['type']"/></td>
                                        <td><t t-esc="ligne['centre']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['nb_sorties']"/></td>
                                        <td style="text-align:center; font-weight:bold;"><t t-esc="ligne['total_litres']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['total_km']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['conso_reelle']"/></td>
                                        <td style="text-align:center;"><t t-esc="ligne['conso_theorique']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot style="background:#d5e8d4; font-weight:bold;">
                                <tr>
                                    <td colspan="5"><t t-esc="lbl['total']"/></td>
                                    <td style="text-align:center;"><t t-esc="donnees['total_litres']"/></td>
                                    <td style="text-align:center;"><t t-esc="donnees['total_km']"/></td>
                                    <td colspan="2"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- SIGNATURE -->
                        <table style="width:100%; margin-top:40px;">
                            <tr>
                                <td style="width:50%; text-align:center;">
                                    <strong><t t-esc="lbl['responsable_energie']"/></strong>
                                    <br/><br/><br/>___________________
                                </td>
                                <td style="width:50%; text-align:center;">
                                    <strong><t t-esc="lbl['directeur_technique']"/></strong>
                                    <br/><br/><br/>___________________
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_vehicules_admin" model="ir.actions.report">
        <field name="name">Consommation Vehicules Administratifs</field>
        <field name="model">transport.wizard.rapport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_vehicules_admin_template</field>
        <field name="report_file">transport_energy.rapport_vehicules_admin_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport"/>
    </record>

</odoo>