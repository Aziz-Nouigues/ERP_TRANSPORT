<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template PDF rapport energie STEG / SONEDE -->
    <template id="rapport_energie_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <t t-set="donnees" t-value="wizard._get_donnees()"/>
                    <div class="page" style="font-family: Arial, sans-serif;">

                        <!-- TITRE -->
                        <div style="text-align:center; margin-bottom:20px;">
                            <h2 style="color:#1a5276; border-bottom:3px solid #1a5276; padding-bottom:8px;">
                                <t t-if="wizard.type_rapport == 'steg'">
                                    Rapport Consommation Electricite (STEG) — kWh
                                </t>
                                <t t-elif="wizard.type_rapport == 'sonede'">
                                    Rapport Consommation Eau (SONEDE) — m³
                                </t>
                                <t t-else="">
                                    Synthese Financiere Energie STEG + SONEDE — TND
                                </t>
                            </h2>
                            <p>
                                <strong>Annee :</strong> <t t-esc="wizard.annee"/>
                                <t t-if="wizard.site_filtre">
                                    | <strong>Site :</strong> <t t-esc="wizard.site_filtre"/>
                                </t>
                                | <strong>Nb factures :</strong> <t t-esc="donnees['nb_factures']"/>
                            </p>
                        </div>

                        <!-- ══ MODE DETAIL (STEG ou SONEDE) ══ -->
                        <t t-if="donnees['mode'] == 'detail'">

                            <!-- Résumé global -->
                            <div style="background:#eaf2ff; padding:10px; border-radius:5px; margin-bottom:15px;">
                                <strong>Résumé :</strong>
                                Total N : <strong><t t-esc="donnees['total_n']"/> <t t-esc="donnees['unite']"/></strong>
                                | Total N-1 : <strong><t t-esc="donnees['total_n1']"/> <t t-esc="donnees['unite']"/></strong>
                                | Montant N : <strong><t t-esc="donnees['total_montant_n']"/> TND</strong>
                                | Ecart :
                                <strong t-attf-style="color: {{ 'red' if donnees['total_ecart'] > 0 else 'green' }}">
                                    <t t-esc="donnees['total_ecart']"/> <t t-esc="donnees['unite']"/>
                                    (<t t-esc="donnees['ecart_pct']"/>%)
                                </strong>
                            </div>

                            <!-- Tableau détail par facture -->
                            <table class="table table-sm table-bordered" style="width:100%; font-size:11px;">
                                <thead style="background:#1a5276; color:white;">
                                    <tr>
                                        <th>Site</th>
                                        <th>N° Compteur</th>
                                        <th>Période</th>
                                        <th style="text-align:center;">Conso N (<t t-esc="donnees['unite']"/>)</th>
                                        <th style="text-align:center;">Montant N (TND)</th>
                                        <th style="text-align:center;">Conso N-1 (<t t-esc="donnees['unite']"/>)</th>
                                        <th style="text-align:center;">Montant N-1 (TND)</th>
                                        <th style="text-align:center;">Ecart</th>
                                        <th style="text-align:center;">%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="donnees['lignes']" t-as="ligne">
                                        <tr t-attf-style="background: {{ '#fdecea' if ligne['ecart_pct'] > 10 else '#eafaf1' if ligne['ecart_pct'] &lt; -5 else 'white' }}">
                                            <td><strong><t t-esc="ligne['site']"/></strong></td>
                                            <td style="text-align:center;"><t t-esc="ligne['compteur']"/></td>
                                            <td style="font-size:10px;"><t t-esc="ligne['periode']"/></td>
                                            <td style="text-align:center; font-weight:bold;"><t t-esc="ligne['qte_n']"/></td>
                                            <td style="text-align:center;"><t t-esc="ligne['montant_n']"/></td>
                                            <td style="text-align:center;"><t t-esc="ligne['qte_n1']"/></td>
                                            <td style="text-align:center;"><t t-esc="ligne['montant_n1']"/></td>
                                            <td t-attf-style="text-align:center; color: {{ 'red' if ligne['ecart'] > 0 else 'green' }}; font-weight:bold;">
                                                <t t-esc="ligne['ecart']"/>
                                            </td>
                                            <td t-attf-style="text-align:center; color: {{ 'red' if ligne['ecart_pct'] > 0 else 'green' }}; font-weight:bold;">
                                                <t t-esc="ligne['ecart_pct']"/>%
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background:#d5e8d4; font-weight:bold;">
                                    <tr>
                                        <td colspan="3" style="text-align:right;">TOTAL</td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_n']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_montant_n']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_n1']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_montant_n1']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_ecart']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['ecart_pct']"/>%</td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Comparaison par site -->
                            <div style="margin-top:20px;">
                                <h4 style="color:#1a5276;">Comparaison par site</h4>
                                <t t-foreach="donnees['par_site']" t-as="site">
                                    <div style="margin-bottom:8px; border:1px solid #ddd; padding:8px; border-radius:4px;">
                                        <strong><t t-esc="site['site']"/></strong>
                                        <span style="margin-left:10px; color:#1a5276;">
                                            N : <t t-esc="site['total_n']"/> <t t-esc="donnees['unite']"/>
                                            | N-1 : <t t-esc="site['total_n1']"/> <t t-esc="donnees['unite']"/>
                                        </span>
                                        <span t-attf-style="color: {{ 'red' if site['ecart'] > 0 else 'green' }}; font-weight:bold; margin-left:10px;">
                                            Ecart : <t t-esc="site['ecart']"/> (<t t-esc="site['ecart_pct']"/>%)
                                        </span>
                                    </div>
                                </t>
                            </div>

                        </t>

                        <!-- ══ MODE SYNTHESE FINANCIERE ══ -->
                        <t t-if="donnees['mode'] == 'synthese'">

                            <!-- Résumé financier global -->
                            <div style="background:#eaf2ff; padding:10px; border-radius:5px; margin-bottom:15px;">
                                <strong>Résumé financier :</strong>
                                STEG N : <strong><t t-esc="donnees['total_steg_n']"/> TND</strong>
                                | SONEDE N : <strong><t t-esc="donnees['total_sonede_n']"/> TND</strong>
                                | Total N : <strong><t t-esc="donnees['total_n']"/> TND</strong>
                                | Total N-1 : <strong><t t-esc="donnees['total_n1']"/> TND</strong>
                                | Ecart :
                                <strong t-attf-style="color: {{ 'red' if donnees['ecart_global'] > 0 else 'green' }}">
                                    <t t-esc="donnees['ecart_global']"/> TND
                                    (<t t-esc="donnees['ecart_pct']"/>%)
                                </strong>
                            </div>

                            <!-- Tableau synthèse par site -->
                            <h4 style="color:#1a5276;">Synthèse financière par site (TND)</h4>
                            <table class="table table-sm table-bordered" style="width:100%; font-size:11px;">
                                <thead style="background:#1a5276; color:white;">
                                    <tr>
                                        <th>Site</th>
                                        <th style="text-align:center;">STEG N (kWh)</th>
                                        <th style="text-align:center;">STEG N (TND)</th>
                                        <th style="text-align:center;">STEG N-1 (TND)</th>
                                        <th style="text-align:center;">SONEDE N (m³)</th>
                                        <th style="text-align:center;">SONEDE N (TND)</th>
                                        <th style="text-align:center;">SONEDE N-1 (TND)</th>
                                        <th style="text-align:center;">Total N (TND)</th>
                                        <th style="text-align:center;">Ecart TND</th>
                                        <th style="text-align:center;">%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="donnees['par_site']" t-as="site">
                                        <tr>
                                            <td><strong><t t-esc="site['site']"/></strong></td>
                                            <td style="text-align:center; color:#555;"><t t-esc="site['steg_qte_n']"/></td>
                                            <td style="text-align:center;"><t t-esc="site['steg_montant_n']"/></td>
                                            <td style="text-align:center;"><t t-esc="site['steg_montant_n1']"/></td>
                                            <td style="text-align:center; color:#555;"><t t-esc="site['sonede_qte_n']"/></td>
                                            <td style="text-align:center;"><t t-esc="site['sonede_montant_n']"/></td>
                                            <td style="text-align:center;"><t t-esc="site['sonede_montant_n1']"/></td>
                                            <td style="text-align:center; font-weight:bold;"><t t-esc="site['total_n']"/></td>
                                            <td t-attf-style="text-align:center; color: {{ 'red' if site['ecart'] > 0 else 'green' }}; font-weight:bold;">
                                                <t t-esc="site['ecart']"/>
                                            </td>
                                            <td t-attf-style="text-align:center; color: {{ 'red' if site['ecart_pct'] > 0 else 'green' }}; font-weight:bold;">
                                                <t t-esc="site['ecart_pct']"/>%
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background:#d5e8d4; font-weight:bold;">
                                    <tr>
                                        <td>TOTAL</td>
                                        <td></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_steg_n']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_steg_n1']"/></td>
                                        <td></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_sonede_n']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_sonede_n1']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['total_n']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['ecart_global']"/></td>
                                        <td style="text-align:center;"><t t-esc="donnees['ecart_pct']"/>%</td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Note unités -->
                            <div style="margin-top:10px; font-size:10px; color:#777; border-top:1px solid #ddd; padding-top:8px;">
                                Note : Les quantités STEG (kWh) et SONEDE (m³) sont affichées à titre indicatif.
                                Seuls les montants en TND sont comparables entre les deux types d'énergie.
                            </div>

                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_rapport_energie_pdf" model="ir.actions.report">
        <field name="name">Rapport STEG/SONEDE N vs N-1</field>
        <field name="model">transport.wizard.rapport.energie</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_energy.rapport_energie_template</field>
        <field name="report_file">transport_energy.rapport_energie_template</field>
        <field name="binding_model_id" ref="model_transport_wizard_rapport_energie"/>
    </record>

</odoo>
