<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fuel_station_form" model="ir.ui.view">
        <field name="name">transport.fuel.station.form</field>
        <field name="model">transport.fuel.station</field>
        <field name="arch" type="xml">
            <form string="Station de pompage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="agency_id"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group string="Cuves">
                            <field name="nb_cuves" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuves">
                            <field name="cuve_ids">
                                <list editable="bottom"
                                      decoration-danger="stock_status == 'critical'"
                                      decoration-warning="stock_status == 'low'">
                                    <field name="fuel_type_id"/>
                                    <field name="pump_number"/>
                                    <field name="capacity"/>
                                    <field name="current_stock" readonly="1"/>
                                    <field name="stock_percentage" readonly="1"/>
                                    <field name="min_stock_alert"/>
                                    <field name="pump_counter_start"/>
                                    <field name="pump_counter_current" readonly="1"/>
                                    <field name="stock_status" widget="badge"
                                           decoration-success="stock_status == 'ok'"
                                           decoration-warning="stock_status == 'low'"
                                           decoration-danger="stock_status == 'critical'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" widget="text" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fuel_station_list" model="ir.ui.view">
        <field name="name">transport.fuel.station.list</field>
        <field name="model">transport.fuel.station</field>
        <field name="arch" type="xml">
            <list string="Stations de pompage">
                <field name="name"/>
                <field name="code"/>
                <field name="agency_id"/>
                <field name="nb_cuves"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_station_search" model="ir.ui.view">
        <field name="name">transport.fuel.station.search</field>
        <field name="model">transport.fuel.station</field>
        <field name="arch" type="xml">
            <search>
                <filter name="low_stock" string="Stock bas"
                        domain="[('cuve_ids.stock_status','in',['low','critical'])]"/>
                <group>
                    <filter name="group_agency" string="Agence" context="{'group_by':'agency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fuel_station" model="ir.actions.act_window">
        <field name="name">Stations de pompage</field>
        <field name="res_model">transport.fuel.station</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fuel_station_search"/>
    </record>

    <menuitem
        id="menu_fuel_station"
        name="Stations de pompage"
        parent="menu_energy_config"
        action="action_fuel_station"
        sequence="20"/>

</odoo>
