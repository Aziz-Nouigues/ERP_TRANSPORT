<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_energy_type_list" model="ir.ui.view">
        <field name="name">transport.energy.type.list</field>
        <field name="model">transport.energy.type</field>
        <field name="arch" type="xml">
            <list string="Types d energie">
                <field name="name"/>
                <field name="category"/>
                <field name="unite"/>
                <field name="conditionnement" optional="show"/>
                <field name="volume_conditionnement" optional="show"
                       string="Vol/unite (L)"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_energy_type_form" model="ir.ui.view">
        <field name="name">transport.energy.type.form</field>
        <field name="model">transport.energy.type</field>
        <field name="arch" type="xml">
            <form string="Type d energie">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="category"/>
                            <field name="unite"/>
                            <field name="active"/>
                        </group>
                        <group string="Conditionnement (optionnel)">
                            <field name="conditionnement"
                                   placeholder="Ex: Bidon, Fut, Cartouche"/>
                            <field name="volume_conditionnement"
                                   string="Volume par unite (L)"
                                   invisible="not conditionnement"
                                   help="Volume en litres dans 1 unite. Ex: 1 Bidon = 10 L"/>
                            <div invisible="not conditionnement or not volume_conditionnement"
                                 class="alert alert-info" role="alert" style="font-size:12px;">
                                Saisie possible en litres OU en nombre d'unités
                                dans les bons lubrifiant.
                                Ex: 5 unités × volume_par_unite = quantité totale en litres.
                            </div>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" widget="text" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_energy_type" model="ir.actions.act_window">
        <field name="name">Types d energie</field>
        <field name="res_model">transport.energy.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_energy_type"
        name="Types d energie"
        parent="menu_energy_config"
        action="action_energy_type"
        sequence="10"/>

</odoo>
