<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_energy_type_list" model="ir.ui.view">
        <field name="name">transport.energy.type.list</field>
        <field name="model">transport.energy.type</field>
        <field name="arch" type="xml">
            <list string="Types d energie">
                <field name="name"/>
                <field name="category"/>
                <field name="unite"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_energy_type_form" model="ir.ui.view">
        <field name="name">transport.energy.type.form</field>
        <field name="model">transport.energy.type</field>
        <field name="arch" type="xml">
            <form string="Type d energie">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="unite"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="notes" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_energy_type" model="ir.actions.act_window">
        <field name="name">Types d energie</field>
        <field name="res_model">transport.energy.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_energy_type"
        name="Types d energie"
        parent="menu_energy_config"
        action="action_energy_type"
        sequence="10"/>

</odoo>
