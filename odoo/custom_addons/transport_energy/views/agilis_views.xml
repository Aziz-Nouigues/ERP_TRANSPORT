<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ VUE CARTE AGILIS ═══ -->
    <record id="view_agilis_carte_form" model="ir.ui.view">
        <field name="name">transport.agilis.carte.form</field>
        <field name="model">transport.agilis.carte</field>
        <field name="arch" type="xml">
            <form string="Carte AGILIS">
                <header>
                    <button name="action_bloquer" string="Bloquer"
                            type="object"
                            invisible="statut != 'active'"
                            groups="transport_energy.group_responsable_energie"/>
                    <button name="action_activer" string="Activer"
                            type="object"
                            invisible="statut != 'bloquee'"
                            groups="transport_energy.group_responsable_energie"/>
                    <field name="statut" widget="statusbar"
                           statusbar_visible="active,bloquee,expiree"/>
                </header>
                <sheet>
                    <field name="alerte_solde" invisible="1"/>
                    <div class="alert alert-warning" role="status" invisible="not alerte_solde">
                        Solde bas — rechargement necessaire avant utilisation.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Numero de carte..."/></h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="vehicle_id"/>
                            <field name="chauffeur_principal"/>
                            <field name="date_emission"/>
                            <field name="date_expiration"/>
                        </group>
                        <group string="Solde">
                            <field name="total_recharge"/>
                            <field name="total_utilise"/>
                            <field name="solde_actuel"/>
                            <field name="solde_minimum"/>
                            <field name="nb_utilisations"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rechargements">
                            <!-- Saisie réservée au Responsable et Directeur -->
                            <field name="recharge_ids"
                                   groups="transport_energy.group_responsable_energie">
                                <list editable="bottom"
                                      decoration-success="state == 'valide'"
                                      decoration-muted="state == 'annule'">
                                    <field name="date"/>
                                    <field name="montant"/>
                                    <field name="reference"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'valide'"
                                           decoration-warning="state == 'brouillon'"
                                           decoration-danger="state == 'annule'"/>
                                    <field name="valide_par"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historique utilisations">
                            <!-- Lecture seule — creees automatiquement par la validation BGE -->
                            <div class="alert alert-info" role="status">
                                Les utilisations sont creees automatiquement
                                lors de la validation d un bon BGE avec paiement AGILIS.
                            </div>
                            <field name="utilisation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="voucher_id"/>
                                    <field name="station_externe"/>
                                    <field name="chauffeur"/>
                                    <field name="quantite"/>
                                    <field name="prix_unitaire"/>
                                    <field name="montant"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agilis_carte_list" model="ir.ui.view">
        <field name="name">transport.agilis.carte.list</field>
        <field name="model">transport.agilis.carte</field>
        <field name="arch" type="xml">
            <list string="Cartes AGILIS"
                  decoration-danger="alerte_solde == True"
                  decoration-muted="statut == 'bloquee'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="chauffeur_principal"/>
                <field name="statut"/>
                <field name="total_recharge"/>
                <field name="total_utilise"/>
                <field name="solde_actuel"/>
                <field name="nb_utilisations"/>
                <field name="alerte_solde" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_agilis_carte_search" model="ir.ui.view">
        <field name="name">transport.agilis.carte.search</field>
        <field name="model">transport.agilis.carte</field>
        <field name="arch" type="xml">
            <search>
                <filter name="active" string="Actives" domain="[('statut','=','active')]"/>
                <filter name="alerte" string="Solde bas" domain="[('alerte_solde','=',True)]"/>
                <filter name="bloquee" string="Bloquees" domain="[('statut','=','bloquee')]"/>
                <group>
                    <filter name="gb_statut" string="Statut" context="{'group_by':'statut'}"/>
                    <filter name="gb_vehicle" string="Vehicule" context="{'group_by':'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agilis_carte" model="ir.actions.act_window">
        <field name="name">Cartes AGILIS</field>
        <field name="res_model">transport.agilis.carte</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_agilis_carte_search"/>
    </record>

    <!-- IMPORTANT : PAS de menu "Utilisations AGILIS" standalone.
         Les utilisations sont consultables depuis l onglet de la carte uniquement.
         Cela evite la double saisie (BGE + utilisation manuelle). -->

    <menuitem
        id="menu_agilis_cartes"
        name="Cartes AGILIS"
        parent="menu_agilis_root"
        action="action_agilis_carte"
        sequence="10"/>

    <!-- ═══ VUE FORM RECHARGEMENT AGILIS ═══ -->
    <record id="view_agilis_recharge_form" model="ir.ui.view">
        <field name="name">transport.agilis.recharge.form</field>
        <field name="model">transport.agilis.recharge</field>
        <field name="arch" type="xml">
            <form string="Rechargement AGILIS">
                <header>
                    <button name="action_valider" string="Valider"
                            type="object"
                            invisible="state != 'brouillon'"
                            class="btn-primary"
                            groups="transport_energy.group_responsable_energie"/>
                    <button name="action_annuler" string="Annuler"
                            type="object"
                            invisible="state != 'valide'"
                            groups="transport_energy.group_directeur_energie"/>
                    <button name="action_reset_brouillon" string="Remettre en brouillon"
                            type="object"
                            invisible="state != 'annule'"
                            groups="transport_energy.group_directeur_energie"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,valide"/>
                </header>
                <sheet>
                    <group>
                        <group string="Rechargement">
                            <field name="carte_id"/>
                            <field name="date"/>
                            <field name="montant"/>
                            <field name="reference"/>
                        </group>
                        <group string="Validation">
                            <field name="valide_par" readonly="1"/>
                            <field name="date_validation" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" widget="text" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- CORRECTION P3 : action distincte pour les rechargements (avant pointait sur action_agilis_carte) -->
    <record id="action_agilis_recharges" model="ir.actions.act_window">
        <field name="name">Rechargements AGILIS</field>
        <field name="res_model">transport.agilis.recharge</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_agilis_recharges"
        name="Rechargements"
        parent="menu_agilis_root"
        action="action_agilis_recharges"
        sequence="20"/>

    <!-- Soldes bas — vue filtrée pour supervision rapide -->
    <record id="action_agilis_alerte" model="ir.actions.act_window">
        <field name="name">Cartes — solde bas</field>
        <field name="res_model">transport.agilis.carte</field>
        <field name="view_mode">list</field>
        <field name="domain">[('alerte_solde','=',True),('statut','=','active')]</field>
    </record>

    <menuitem
        id="menu_agilis_alerte"
        name="Alertes solde bas"
        parent="menu_agilis_root"
        action="action_agilis_alerte"
        sequence="30"
        groups="transport_energy.group_responsable_energie"/>

</odoo>
