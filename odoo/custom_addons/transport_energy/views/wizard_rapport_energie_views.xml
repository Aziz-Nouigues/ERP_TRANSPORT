<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_rapport_energie_form" model="ir.ui.view">
        <field name="name">transport.wizard.rapport.energie.form</field>
        <field name="model">transport.wizard.rapport.energie</field>
        <field name="arch" type="xml">
            <form string="Rapport energie STEG / SONEDE">
                <group>
                    <group string="Type de rapport">
                        <field name="type_rapport" widget="radio"/>
                    </group>
                    <group string="Filtres">
                        <field name="annee"/>
                        <field name="site_filtre"
                               placeholder="Laisser vide pour tous les sites"/>
                    </group>
                </group>

                <!-- Description contextuelle selon le type choisi -->
                <div class="alert alert-info" role="alert"
                     invisible="type_rapport != 'steg'">
                    Rapport détaillé consommation électrique (kWh) par site et par
                    période, avec comparaison année N vs N-1.
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="type_rapport != 'sonede'">
                    Rapport détaillé consommation eau (m³) par site et par période,
                    avec comparaison année N vs N-1.
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="type_rapport != 'synthese'">
                    Synthèse financière globale en TND. STEG et SONEDE sont présentés
                    dans des sections distinctes — les quantités (kWh et m³) ne sont
                    jamais additionnées ensemble.
                </div>

                <footer>
                    <button name="action_generer"
                            string="Generer rapport PDF"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_rapport_energie" model="ir.actions.act_window">
        <field name="name">Rapport energie STEG / SONEDE</field>
        <field name="res_model">transport.wizard.rapport.energie</field>
        <field name="view_id" ref="view_wizard_rapport_energie_form"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_rapport_energie_steg"
        name="Rapport energie STEG / SONEDE"
        parent="menu_rapports_root"
        action="action_wizard_rapport_energie"
        sequence="30"/>

</odoo>
