<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_fuel_voucher_form" model="ir.ui.view">
        <field name="name">transport.fuel.voucher.form</field>
        <field name="model">transport.fuel.voucher</field>
        <field name="arch" type="xml">
            <form string="Bon de Ravitaillement Carburant">
                <header>
                    <button name="action_validate"
                            string="Valider"
                            type="object"
                            class="btn-success"
                            groups="transport_energy.group_responsable_energie"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            groups="transport_energy.group_responsable_energie"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_confirm"
                            string="Confirmer"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft"
                            string="Remettre en brouillon"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="voucher_type"/>
                            <field name="date"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                        </group>
                        <group string="Station">
                            <field name="station_id"/>
                            <field name="fuel_type_id"/>
                            <field name="agency_main_code"/>
                            <field name="agency_sub_code"/>
                        </group>
                    </group>
                    <group>
                        <group string="Agent">
                            <field name="distributor_code"/>
                            <field name="distributor_name"/>
                        </group>
                        <group string="Compteur">
                            <field name="pump_counter_start"/>
                            <field name="pump_counter_end"/>
                            <field name="remaining_stock"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes de ravitaillement">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="time" widget="float_time"/>
                                    <field name="vehicle_id"/>
                                    <field name="service_code"/>
                                    <field name="driver_code"/>
                                    <field name="driver_name"/>
                                    <field name="odometer_value"/>
                                    <field name="odometer_status"/>
                                    <field name="distance_estimated"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                            <group>
                                <field name="total_quantity"
                                       string="Total distribué (L)"
                                       readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_fuel_voucher_list" model="ir.ui.view">
        <field name="name">transport.fuel.voucher.list</field>
        <field name="model">transport.fuel.voucher</field>
        <field name="arch" type="xml">
            <list string="Bons de Carburant"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="voucher_type"/>
                <field name="total_quantity"/>
                <field name="remaining_stock"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ================= ACTIONS ================= -->
    <record id="action_fuel_voucher_internal" model="ir.actions.act_window">
        <field name="name">Bons Internes (BGI)</field>
        <field name="res_model">transport.fuel.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type','=','internal')]</field>
        <field name="context">{'default_voucher_type': 'internal'}</field>
        
    </record>

    <record id="action_fuel_voucher_external" model="ir.actions.act_window">
        <field name="name">Bons Externes (BGE)</field>
        <field name="res_model">transport.fuel.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type','=','external')]</field>
        <field name="context">{'default_voucher_type': 'external'}</field>
        
    </record>

    <!-- ================= MENUS ================= -->
    <menuitem
        id="menu_fuel_vouchers"
        name="⛽ Carburant"
        parent="menu_transport_energy_root"
        sequence="10"/>

    <menuitem
        id="menu_fuel_voucher_internal"
        name="Bons Internes (BGI)"
        parent="menu_fuel_vouchers"
        action="action_fuel_voucher_internal"
        sequence="10"/>

    <menuitem
        id="menu_fuel_voucher_external"
        name="Bons Externes (BGE)"
        parent="menu_fuel_vouchers"
        action="action_fuel_voucher_external"
        sequence="20"/>

</odoo>


